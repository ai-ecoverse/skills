# Build intermediates: the bundle is spliced into the panel, which IS committed,
# so the loose copy is noise.
.build/

# The XSS gate page is GENERATED by scripts/build.sh and inlines the whole bundle
# (~78 KB), which is already committed inside the panel. Regenerate it rather than
# carrying a second copy:
#   ./scripts/build.sh && open tests/xss-gate.html
tests/xss-gate.html
