{
  "note": "Acceptance gate for src/markdown.js. Every fixture is text that could arrive in a GitHub issue body or comment. A panel XSS is arbitrary command execution with full VFS access (the sprinkle bridge exposes exec/readDir/writeFile/rm/fetch/agent), so each case must be shown BOTH not to execute and not to leave the dangerous attribute or scheme in the resulting DOM. Fixtures that set window.__xssFired are the execution canaries. Phase 7m adds the trusted-image-host cases: imgSrcAllOf/imgAttrs assertions inspect the built <img>, which the panel creates itself from a vetted, NORMALISED URL — no src from input is ever assigned to an img element.",
  "fixtures": [
    {
      "id": "script-tag",
      "md": "hello <script>window.__xssFired='script-tag'</script> world",
      "expect": {
        "noTags": [
          "script"
        ],
        "textContains": "hello"
      }
    },
    {
      "id": "img-onerror",
      "md": "![x](y) <img src=x onerror=\"window.__xssFired='img-onerror'\">",
      "expect": {
        "noTags": [
          "img"
        ],
        "noAttrs": [
          "onerror",
          "src"
        ]
      }
    },
    {
      "id": "svg-onload",
      "md": "<svg onload=\"window.__xssFired='svg-onload'\"><circle r=10 /></svg>",
      "expect": {
        "noTags": [
          "svg",
          "circle"
        ],
        "noAttrs": [
          "onload"
        ]
      }
    },
    {
      "id": "link-javascript",
      "md": "[click me](javascript:window.__xssFired='link-js')",
      "expect": {
        "noHrefScheme": [
          "javascript:"
        ],
        "textContains": "click me"
      }
    },
    {
      "id": "link-javascript-obfuscated",
      "md": "[obf](java\tscript:window.__xssFired='obf')",
      "expect": {
        "noHrefScheme": [
          "javascript:",
          "java"
        ]
      }
    },
    {
      "id": "link-javascript-entity",
      "md": "[ent](&#106;avascript:window.__xssFired='ent')",
      "expect": {
        "noHrefScheme": [
          "javascript:"
        ]
      }
    },
    {
      "id": "link-data-html",
      "md": "[data](data:text/html;base64,PHNjcmlwdD53aW5kb3cuX194c3NGaXJlZD0nZGF0YSc8L3NjcmlwdD4=)",
      "expect": {
        "noHrefScheme": [
          "data:"
        ]
      }
    },
    {
      "id": "link-vbscript",
      "md": "[vb](vbscript:msgbox(1))",
      "expect": {
        "noHrefScheme": [
          "vbscript:"
        ]
      }
    },
    {
      "id": "img-data-uri",
      "md": "![i](data:image/svg+xml;base64,PHN2ZyBvbmxvYWQ9J3dpbmRvdy5fX3hzc0ZpcmVkPSJpbWciJz48L3N2Zz4=)",
      "expect": {
        "noTags": [
          "img"
        ],
        "noHrefScheme": [
          "data:"
        ]
      }
    },
    {
      "id": "img-untrusted-host",
      "md": "![badge](https://img.shields.io/badge/a-b.svg)",
      "expect": {
        "noTags": [
          "img"
        ],
        "noAttrs": [
          "src"
        ]
      },
      "note": "7m: an untrusted host still becomes a link, never an <img>."
    },
    {
      "id": "iframe",
      "md": "<iframe src=\"https://example.com/x\" onload=\"window.__xssFired='iframe'\"></iframe>",
      "expect": {
        "noTags": [
          "iframe"
        ],
        "noAttrs": [
          "src",
          "onload"
        ]
      }
    },
    {
      "id": "object-embed",
      "md": "<object data=\"javascript:window.__xssFired='object'\"></object><embed src=\"x.swf\">",
      "expect": {
        "noTags": [
          "object",
          "embed"
        ],
        "noAttrs": [
          "data",
          "src"
        ]
      }
    },
    {
      "id": "handler-on-allowed-tag",
      "md": "<p onmouseover=\"window.__xssFired='handler'\" onclick=\"window.__xssFired='handler2'\">hover me</p>",
      "expect": {
        "noAttrs": [
          "onmouseover",
          "onclick"
        ],
        "textContains": "hover me"
      }
    },
    {
      "id": "html-in-fenced-code",
      "md": "```html\n<script>window.__xssFired='fenced'</script>\n```",
      "expect": {
        "noTags": [
          "script"
        ],
        "hasTags": [
          "pre",
          "code"
        ],
        "textContains": "<script>"
      }
    },
    {
      "id": "html-in-inline-code",
      "md": "inline `<img src=x onerror=window.__xssFired='inline'>` span",
      "expect": {
        "noTags": [
          "img"
        ],
        "hasTags": [
          "code"
        ],
        "textContains": "onerror"
      },
      "note": "The dangerous string must survive as TEXT inside <code> — that is correct rendering. The gate therefore checks attributes, never serialised HTML, or escaped text trips it."
    },
    {
      "id": "target-from-input",
      "md": "<a href=\"https://example.com\" target=\"_self\" rel=\"opener\">link</a>",
      "expect": {
        "anchorsAllBlank": true
