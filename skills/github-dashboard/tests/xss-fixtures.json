    },
    {
      "id": "img-no-vbscript",
      "md": "![shot](vbscript:msgbox(1))",
      "expect": {
        "noTags": [
          "img"
        ],
        "textContains": "shot"
      },
      "note": "scheme"
    },
    {
      "id": "img-raw-tag-handlers",
      "md": "<img src=\"https://github.com/user-attachments/assets/a.png\" onerror=\"window.__xssFired='img-onerror-trusted'\" onload=\"window.__xssFired='img-onload-trusted'\">",
      "expect": {
        "noTags": [
          "img"
        ],
        "noAttrs": [
          "onerror",
          "onload",
          "src"
        ]
      },
      "note": "A RAW <img> tag is dropped entirely (img is not in the sanitiser allowlist; only markdown images become pictures), so a permitted tag can never bring its handlers."
    },
    {
      "id": "img-raw-tag-extra-attrs",
      "md": "<img src=\"https://raw.githubusercontent.com/a.png\" srcset=\"https://evil.com/x 2x\" usemap=\"#m\" loading=\"eager\" referrerpolicy=\"unsafe-url\" width=\"9999\">",
      "expect": {
        "noTags": [
          "img"
        ],
        "noAttrs": [
          "srcset",
          "usemap",
          "loading",
          "referrerpolicy",
          "width",
          "src"
        ]
      },
      "note": "srcset is the interesting one: it would smuggle a second, unchecked host past a src-only check."
    },
    {
      "id": "img-placeholder-forged",
      "md": "<span data-img-src=\"https://evil.com/x.png\">forged</span>",
      "expect": {
        "noTags": [
          "img"
        ],
        "noAttrs": [
          "src"
        ]
      },
      "note": "The placeholder the renderer uses is re-validated by the post-pass, so forging one in raw HTML cannot load an untrusted image."
    },
    {
      "id": "img-placeholder-forged-trusted",
      "md": "<span data-img-src=\"https://github.com/user-attachments/assets/ok.png\">forged-ok</span>",
      "expect": {
        "hasTags": [
          "img"
        ],
        "imgAttrs": {
          "referrerpolicy": "no-referrer",
          "alt": "forged-ok"
        }
      },
      "note": "A forged placeholder pointing at a TRUSTED host does render — which is the same thing the feature already permits, and it is stated here so the behaviour is deliberate."
    }
  ]
}
