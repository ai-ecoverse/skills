// TikTok web API client -- generated by secret-sauce.
//
// TikTok's web app protects its own JSON API (/api/*) with anti-bot request
// signatures (X-Bogus / X-Gnarly / X-Dynosaur / msToken). These are injected
// automatically by TikTok's own `webmssdk` bundle, which hooks window.fetch and
// XMLHttpRequest on the page. So the ONLY reliable way to call the API is to
// issue the fetch() from inside a real, logged-in www.tiktok.com tab -- the
// webmssdk interceptor then signs the outbound request for us. We do that via
// browser.evalAsync (page-context eval). Direct Node fetch() would be rejected.
//
// Direct messages (DMs) are delivered over an encrypted "Frontier" WebSocket,
// not REST, so conversation history / send are handled through the rendered DOM
// (playwright-cli), not the API.

const { exec } = require('sliccy:exec');
const browser = require('sliccy:browser');
const fs = require('fs');

const TT_DOMAIN = 'www.tiktok.com';
const TMP_DIR = '/workspace/skills/tiktok/.tmp';

// ---------------------------------------------------------------------------
// Tab management
// ---------------------------------------------------------------------------

let _tab = null;

async function findTab() {
  if (_tab) return _tab;
  // Prefer a main web-app page (root / profile / video / search / messages).
  // Explicitly avoid tiktokstudio, ads, and other sub-apps whose page
  // app-context is structured differently (no webapp user, wrong appId).
  let tab = await browser.findTab({ urlMatch: /www\.tiktok\.com\/(@|foryou|search|explore|following|friends|messages|explore|$|\?)/ });
  if (!tab) tab = await browser.findTab({ urlMatch: /www\.tiktok\.com\/(?!tiktokstudio|ads|business)/ });
  if (!tab) tab = await browser.findTab({ domain: TT_DOMAIN });
  if (!tab) tab = await browser.findTab({ urlMatch: /(^|\.)tiktok\.com/ });
  if (!tab) {
    console.error('Error: No TikTok tab found. Open https://www.tiktok.com in your browser (logged in) and try again.');
    process.exit(1);
  }
  _tab = tab;
  return _tab;
}

// ---------------------------------------------------------------------------
// API helper -- page-context fetch, auto-signed by webmssdk
// ---------------------------------------------------------------------------

// Core signed request. Runs a fetch from inside the TikTok tab's MAIN world
// (via `playwright-cli eval-file`), where TikTok's webmssdk hooks window.fetch
// to inject the anti-bot signature (X-Bogus/X-Gnarly/msToken). browser.evalAsync
// runs an isolated world without that hook, so signature-required endpoints
// reject with 10201/HTTP 400 -- that's why we shell out to eval-file here.
//
// opts: { url, method='GET', query={}, body=null, useCommon=true }
//   - url: a path ('/api/...') or absolute URL. Any existing query string is kept.
//   - query: extra query params merged in (after the common params).
//   - body: object -> JSON-stringified POST/PUT body.
//   - useCommon: prepend the standard TikTok web params (aid=1988, device_id,
//     region, odinId, ...) read live from the page app-context.
// Returns { status, bodyText, data } where data is parsed JSON or null.
async function signedRequest(opts) {
  const { url, method = 'GET', query = {}, body = null, useCommon = true } = opts;
  const tab = await findTab();
  const expr = `
    (async () => {
      let ctx = {};
      try {
        const el = document.getElementById('__UNIVERSAL_DATA_FOR_REHYDRATION__');
        if (el) ctx = JSON.parse(el.textContent).__DEFAULT_SCOPE__['webapp.app-context'] || {};
      } catch (e) {}
      const nav = navigator;
      const uid = (ctx.user && (ctx.user.uid || ctx.user.userId)) || '';
      const os = /Mac/.test(nav.platform) ? 'mac' : /Win/.test(nav.platform) ? 'windows' : 'linux';
      const base = {
        aid: '1988',
        app_name: 'tiktok_web',
        app_language: ctx.language || 'en',
        channel: 'tiktok_web',
        device_platform: 'web_pc',
        region: ctx.region || 'US',
        priority_region: ctx.region || '',
        os: os,
        cookie_enabled: String(nav.cookieEnabled),
        screen_width: String(screen.width),
        screen_height: String(screen.height),
        browser_language: nav.language || 'en-US',
        browser_platform: nav.platform || 'MacIntel',
        browser_name: 'Mozilla',
        browser_online: String(nav.onLine),
        device_id: String(ctx.wid || ctx.webId || ''),
        odinId: String(uid),
        user_is_login: String(!!uid),
        webcast_language: ctx.language || 'en',
        tz_name: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC',
        from_page: 'fyp'
      };
      const useCommon = ${JSON.stringify(useCommon)};
      const query = ${JSON.stringify(query)};
      const merged = useCommon ? Object.assign({}, base, query) : query;
      const qs = new URLSearchParams(merged).toString();
      let u = ${JSON.stringify(url)};
      if (qs) u += (u.indexOf('?') === -1 ? '?' : '&') + qs;
      const init = { method: ${JSON.stringify(method)}, credentials: 'include', headers: { accept: 'application/json, text/plain, */*' } };
      const bodyObj = ${JSON.stringify(body)};
      if (bodyObj != null) { init.headers['content-type'] = 'application/json'; init.body = typeof bodyObj === 'string' ? bodyObj : JSON.stringify(bodyObj); }
      const r = await fetch(u, init);
      const text = await r.text();
      return JSON.stringify({ __ttStatus: r.status, __ttBody: text });
    })()
  `;
  // eval-file needs a file in the VFS; use a fixed per-command pair (overwritten
  // each call) so the .tmp dir never accumulates cruft.
  if (typeof fs.mkdirSync === 'function') { try { fs.mkdirSync(TMP_DIR, { recursive: true }); } catch (e) {} }
  const exprFile = `${TMP_DIR}/req.js`;
  const outFile = `${TMP_DIR}/res.json`;

  async function runOnce() {
    try {
      fs.writeFileSync(exprFile, expr);
      const { stderr } = await exec(`playwright-cli eval-file ${exprFile} --tab=${tab.targetId} --output=${outFile}`);
      let out = null;
      try { out = fs.readFileSync(outFile, 'utf8'); } catch (e) {}
      if (!out) return { fail: 'no-output', stderr };
      return { env: JSON.parse(out) };
    } catch (e) {
      return { fail: e && e.message ? e.message : String(e) };
    }
  }

  let res = await runOnce();
  // A 200 with an empty body is TikTok's soft anti-abuse throttle. Back off once.
  const isThrottled = (r) => r.env && r.env.__ttStatus === 200 && !r.env.__ttBody;
  if (res.fail === 'no-output' || isThrottled(res)) {
    await new Promise((r) => setTimeout(r, 3000));
    res = await runOnce();
  }

  if (res.fail && !res.env) {
    console.error('Page eval failed:', res.fail);
    if (res.stderr) console.error(res.stderr.trim());
    console.error('The TikTok tab may have navigated or lost its context. Reload www.tiktok.com and retry.');
    process.exit(1);
  }
  const status = res.env.__ttStatus;
  const bodyText = res.env.__ttBody;
  let data = null;
  if (bodyText) { try { data = JSON.parse(bodyText); } catch (e) {} }
  return { status, bodyText, data };
}

// Convenience wrapper: GET a path with common params, return parsed JSON or exit
// with a clear message on the common failure modes.
async function apiGet(path, params = {}) {
  const { status, bodyText, data } = await signedRequest({ url: path, query: params });
  if (status === 401 || status === 403) {
    console.error(`Error: TikTok returned HTTP ${status}. Your session may have expired -- log into www.tiktok.com in your browser and try again.`);
    process.exit(1);
  }
  if (!bodyText) {
    console.error(`Error: TikTok returned an empty body (HTTP ${status}). TikTok is throttling this session (too many requests in a short window). Wait ~30s and retry, or reload www.tiktok.com.`);
    process.exit(1);
  }
  if (data == null) {
    console.error(`Error: could not parse TikTok response (HTTP ${status}): ${bodyText.slice(0, 200)}`);
    process.exit(1);
  }
  if (data.status_code === 10201) {
    console.error('Error: TikTok rejected the request signature (status 10201). Make sure the active tab is a fully-loaded www.tiktok.com page (not /messages or a login page), then retry.');
    process.exit(1);
  }
  return data;
}

function num(n) {
  n = Number(n) || 0;
  if (n >= 1e9) return (n / 1e9).toFixed(1) + 'B';
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'K';
  return String(n);
}

function ts(sec) {
  if (!sec) return '';
  try { return new Date(Number(sec) * 1000).toISOString().replace('T', ' ').slice(0, 16); }
  catch (e) { return String(sec); }
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------

async function cmdWhoami() {
  const tab = await findTab();
  const raw = await browser.evalAsync(tab, `
    (() => {
      try {
        const el = document.getElementById('__UNIVERSAL_DATA_FOR_REHYDRATION__');
        const ctx = JSON.parse(el.textContent).__DEFAULT_SCOPE__['webapp.app-context'] || {};
        const u = ctx.user || {};
        return JSON.stringify({ loggedIn: !!(u.uid), uniqueId: u.uniqueId, nickName: u.nickName, uid: u.uid, secUid: u.secUid, region: u.region || ctx.region, isPrivate: u.isPrivateAccount });
      } catch (e) { return JSON.stringify({ error: String(e) }); }
    })()
  `.trim().replace(/\n/g, ' '));
  const u = typeof raw === 'string' ? JSON.parse(raw) : raw;
  if (u.error || !u.loggedIn) {
    console.error('Not logged in to TikTok, or the app-context could not be read. Open www.tiktok.com and sign in.');
    process.exit(1);
  }
  console.log(JSON.stringify(u, null, 2));
  return u;
}

async function cmdSearch(args, flags) {
  const keyword = args.join(' ').trim();
  if (!keyword) { console.error('Usage: tiktok search <query> [--type=general|video|user] [--count=N] [--cursor=N]'); process.exit(1); }
  const type = flags.type || 'general';
  const count = flags.count || '12';
  const cursor = flags.cursor || '0';

  if (type === 'user') {
    const d = await apiGet('/api/search/user/full/', { keyword, count, cursor, from_page: 'search' });
    const list = d.user_list || [];
    console.log(`Users matching "${keyword}" (${list.length}):\n`);
    for (const u of list) {
      const info = u.user_info || {};
      console.log(`@${info.unique_id}  "${info.nickname || ''}"`);
      console.log(`  followers: ${num(info.follower_count)}   secUid: ${info.sec_uid}`);
      if (info.signature) console.log(`  ${info.signature.replace(/\n/g, ' ').slice(0, 80)}`);
      console.log('');
    }
    console.log(`cursor: ${d.cursor}   has_more: ${d.has_more}`);
    return;
  }

  if (type === 'video') {
    const d = await apiGet('/api/search/item/full/', { keyword, count, cursor, offset: cursor, from_page: 'search' });
    const list = d.item_list || [];
    printVideoList(list.map((it) => it), `Videos matching "${keyword}"`);
    console.log(`cursor: ${d.cursor}   has_more: ${d.has_more}`);
    return;
  }

  // general: mixed feed of items + users
  const d = await apiGet('/api/search/general/full/', {
    keyword, count, cursor, offset: cursor, from_page: 'search',
    web_search_code: '{"tiktok":{"client_params_x":{"search_engine":{"ies_mt_user_live_video_card_use_libra":1,"mt_search_general_user_live_card":1}},"search_server":{}}}'
  });
  const data = d.data || [];
  console.log(`Search results for "${keyword}" (${data.length}):\n`);
  for (const row of data) {
    if (row.item) {
      const it = row.item;
      const s = it.statsV2 || it.stats || {};
      console.log(`[video] ${it.id}  @${it.author && it.author.uniqueId}`);
      console.log(`  ${(it.desc || '').replace(/\n/g, ' ').slice(0, 80)}`);
      console.log(`  ▶ ${num(s.playCount)}  ❤ ${num(s.diggCount)}  💬 ${num(s.commentCount)}  ↪ ${num(s.shareCount)}`);
    } else if (row.user_list && row.user_list[0]) {
      const info = row.user_list[0].user_info || {};
      console.log(`[user] @${info.unique_id}  "${info.nickname || ''}"  followers: ${num(info.follower_count)}`);
    }
    console.log('');
  }
  console.log(`cursor: ${d.cursor}   has_more: ${d.has_more}`);
}

function printVideoList(items, title) {
  console.log(`${title} (${items.length}):\n`);
  for (const it of items) {
    const s = it.statsV2 || it.stats || {};
    console.log(`${it.id}  @${it.author && (it.author.uniqueId || it.author.unique_id)}`);
    console.log(`  ${(it.desc || '').replace(/\n/g, ' ').slice(0, 80)}`);
    console.log(`  ▶ ${num(s.playCount)}  ❤ ${num(s.diggCount)}  💬 ${num(s.commentCount)}  ↪ ${num(s.shareCount)}  🔖 ${num(s.collectCount)}   posted: ${ts(it.createTime)}`);
    console.log('');
  }
}

async function cmdVideo(args) {
  const id = (args[0] || '').replace(/[^0-9]/g, '');
  if (!id) { console.error('Usage: tiktok video <videoId>   (numeric id, e.g. from a tiktok.com/@user/video/<id> URL)'); process.exit(1); }
  const d = await apiGet('/api/item/detail/', { itemId: id });
  const it = d.itemInfo && d.itemInfo.itemStruct;
  if (!it) { console.error(`No video found for id ${id} (status_code=${d.status_code}, msg="${d.status_msg || ''}").`); process.exit(1); }
  const s = it.statsV2 || it.stats || {};
  const a = it.author || {};
  console.log(`Video ${it.id}`);
  console.log(`  author:   @${a.uniqueId}  "${a.nickname || ''}"`);
  console.log(`  desc:     ${(it.desc || '').replace(/\n/g, ' ')}`);
  console.log(`  posted:   ${ts(it.createTime)}`);
  console.log(`  duration: ${it.video && it.video.duration}s`);
  console.log('  --- stats ---');
  console.log(`  plays:    ${num(s.playCount)}  (${s.playCount})`);
  console.log(`  likes:    ${num(s.diggCount)}  (${s.diggCount})`);
  console.log(`  comments: ${num(s.commentCount)}  (${s.commentCount})`);
  console.log(`  shares:   ${num(s.shareCount)}  (${s.shareCount})`);
  console.log(`  saves:    ${num(s.collectCount)}  (${s.collectCount})`);
  if (s.repostCount != null) console.log(`  reposts:  ${num(s.repostCount)}  (${s.repostCount})`);
  console.log(`  url:      https://www.tiktok.com/@${a.uniqueId}/video/${it.id}`);
}

async function cmdComments(args, flags) {
  const id = (args[0] || '').replace(/[^0-9]/g, '');
  if (!id) { console.error('Usage: tiktok comments <videoId> [--count=N] [--cursor=N]'); process.exit(1); }
  const d = await apiGet('/api/comment/list/', { aweme_id: id, count: flags.count || '20', cursor: flags.cursor || '0' });
  const comments = d.comments || [];
  console.log(`Comments on ${id} (${comments.length} of ${d.total}):\n`);
  for (const c of comments) {
    const u = c.user || {};
    console.log(`@${u.unique_id}  ❤ ${num(c.digg_count)}   ${ts(c.create_time)}`);
    console.log(`  ${(c.text || '').replace(/\n/g, ' ')}`);
    console.log('');
  }
  console.log(`cursor: ${d.cursor}   has_more: ${d.has_more}`);
}

// Reads the logged-in user's own secUid from the page app-context. Used to
// default the profile-list commands when no secUid is given -- handy since the
// Liked / Favorites tabs are usually only visible for your own account.
async function ownSecUid() {
  const tab = await findTab();
  const raw = await browser.evalAsync(tab, `
    (() => { try { const el=document.getElementById('__UNIVERSAL_DATA_FOR_REHYDRATION__'); const c=JSON.parse(el.textContent).__DEFAULT_SCOPE__['webapp.app-context']||{}; return JSON.stringify({secUid:(c.user&&c.user.secUid)||''}); } catch(e){ return JSON.stringify({secUid:''}); } })()
  `.trim().replace(/\n/g, ' '));
  const o = typeof raw === 'string' ? JSON.parse(raw) : raw;
  return o.secUid || '';
}

// The four profile tabs share the same item_list shape (itemList/cursor/hasMore).
const PROFILE_TABS = {
  posted: { path: '/api/post/item_list/', label: 'Posted videos' },
  reposts: { path: '/api/repost/item_list/', label: 'Reposted videos' },
  liked: { path: '/api/favorite/item_list/', label: 'Liked videos' },
  favorites: { path: '/api/user/collect/item_list/', label: 'Favorited videos' },
};

// Shared implementation for posted/reposts/liked/favorites. `tabKey` selects the
// endpoint. secUid defaults to the logged-in user when omitted.
async function profileList(tabKey, args, flags) {
  const t = PROFILE_TABS[tabKey];
  let secUid = args[0];
  if (!secUid) {
    secUid = await ownSecUid();
    if (!secUid) {
      console.error(`Usage: tiktok ${tabKey} [<secUid>] [--count=N] [--cursor=N]`);
      console.error('No secUid given and could not read your own from the page. Get one via "tiktok search <name> --type=user".');
      process.exit(1);
    }
  }
  const d = await apiGet(t.path, {
    secUid,
    count: flags.count || '15',
    cursor: flags.cursor || '0',
    coverFormat: '2',
  });
  const items = d.itemList || [];
  if (!items.length) {
    console.log(`${t.label} (0) for secUid ${secUid.slice(0, 16)}...`);
    console.log('(Empty — this tab has no videos, or Liked/Favorites are private and only visible on your own account.)');
    return;
  }
  printVideoList(items, `${t.label} for secUid ${secUid.slice(0, 16)}...`);
  console.log(`cursor: ${d.cursor}   hasMore: ${d.hasMore}`);
}

async function cmdUserVideos(args, flags) { return profileList('posted', args, flags); }
async function cmdReposts(args, flags) { return profileList('reposts', args, flags); }
async function cmdLiked(args, flags) { return profileList('liked', args, flags); }
async function cmdFavorites(args, flags) { return profileList('favorites', args, flags); }

async function cmdNoticeCount() {
  const d = await apiGet('/api/notice/count/', {});
  const counts = d.notice_count || [];
  const names = {
    0: 'all', 1: 'system', 2: 'likes', 3: 'comments', 4: 'mentions',
    6: 'followers', 7: 'from-tiktok', 12: 'account-updates', 13: 'promotions',
    20: 'video-updates', 36: 'shop'
  };
  console.log('Unread notification counts by group:\n');
  for (const c of counts) {
    if (!c.count) continue;
    console.log(`  ${String(c.group).padEnd(4)} ${(names[c.group] || 'group ' + c.group).padEnd(18)} ${c.count}`);
  }
  const total = counts.find((c) => c.group === 0);
  console.log(`\n  total (group 0): ${total ? total.count : 0}`);
}

async function cmdNotifications(args, flags) {
  const group = flags.group || '500'; // 500 = combined "All activity" feed
  const count = Number(flags.count || '20');
  const markRead = flags['mark-read'] ? 1 : 0;
  const maxTime = flags.cursor ? Number(flags.cursor) : 0;
  const groupList = JSON.stringify([{ count, is_mark_read: markRead, group: Number(group), max_time: maxTime, min_time: 0 }]);
  const d = await apiGet('/api/notice/multi/', { group_list: groupList, from_page: 'activity' });
  const lists = d.notice_lists || [];
  const notices = (lists[0] && lists[0].notice_list) || [];

  const typeName = {
    1: 'system', 2: 'like', 3: 'comment', 6: 'follow', 12: 'update',
    41: 'suggested-account', 43: 'like', 44: 'friend-joined', 45: 'mention',
    56: 'reply', 62: 'comment', 74: 'follow-request', 82: 'mention', 87: 'tag'
  };

  console.log(`Notifications (group ${group}, ${notices.length}):\n`);
  for (const n of notices) {
    const label = typeName[n.type] || `type ${n.type}`;
    const read = n.has_read ? ' ' : '•';
    let who = '';
    let text = '';
    const dg = n.digg || n.comment || n.follow || n.at || n.mention || {};
    const from = dg.from_user || (dg.user_list && dg.user_list[0]) || n.from_user;
    if (from) who = '@' + (from.unique_id || from.uid || '');
    if (n.comment && n.comment.comment) text = n.comment.comment.text || '';
    if (dg.content) text = dg.content;
    console.log(`${read} [${label}] ${who}  ${ts(n.create_time)}`);
    if (text) console.log(`    ${text.replace(/\n/g, ' ').slice(0, 100)}`);
  }
  console.log(`\nhas_more: ${lists[0] && lists[0].has_more}`);
  if (notices.length) console.log(`next --cursor (max_time): ${notices[notices.length - 1].create_time}`);
  if (markRead) console.log('(marked as read)');
}

// ---------------------------------------------------------------------------
// Direct messages -- DOM based (Frontier WebSocket has no REST equivalent)
// ---------------------------------------------------------------------------

function targetId() {
  return findTab().then((t) => t.targetId);
}

async function ensureMessagesPage() {
  const tab = await findTab();
  const url = await browser.eval(tab, "location.pathname");
  if (!String(url).startsWith('/messages')) {
    await exec(`playwright-cli goto https://www.tiktok.com/messages --tab=${tab.targetId}`).catch(() => {});
    // goto acts on the active tab; fall back to in-page navigation which is reliable.
    await browser.eval(tab, "location.href = 'https://www.tiktok.com/messages'");
    await new Promise((r) => setTimeout(r, 5000));
  }
  return tab;
}

// Reads the rendered conversation list from the messages page DOM. Returns
// [{ name, preview, time, unread }]. Shared by `conversations` and `monday`.
async function readConversationsDom() {
  const tab = await ensureMessagesPage();
  const raw = await browser.evalAsync(tab, `
    (async () => {
      const rows = [...document.querySelectorAll('[class*="DivItemWrapper"]')];
      const out = [];
      for (const row of rows) {
        const ps = row.querySelectorAll('p');
        if (!ps.length) continue;
        const name = (ps[0] && ps[0].textContent || '').trim();
        if (!name) continue;
        const preview = (row.querySelector('p p') && row.querySelector('p p').textContent || '').trim();
        const times = [...row.querySelectorAll('*')].map(e => e.childNodes.length===1 && e.childNodes[0].nodeType===3 ? e.textContent.trim() : '').filter(t => /\\d{1,2}\\/\\d{1,2}\\/\\d{4}/.test(t));
        const badge = (row.querySelector('[class*="Badge"], sup, [class*="unread"]') || {}).textContent || '';
        out.push({ name, preview: preview.slice(0, 120), time: times[0] || '', unread: (badge || '').trim() });
      }
      return JSON.stringify(out);
    })()
  `.trim().replace(/\n/g, ' '));
  return typeof raw === 'string' ? JSON.parse(raw) : raw;
}

async function cmdConversations() {
  const list = await readConversationsDom();
  if (!list.length) {
    console.log('No conversations found (the messages list may still be loading, or you have no DMs).');
    return;
  }
  console.log(`Conversations (${list.length}):\n`);
  for (const c of list) {
    const u = c.unread && c.unread !== '0' ? ` [${c.unread} unread]` : '';
    console.log(`${c.name}${u}   ${c.time}`);
    if (c.preview) console.log(`  ${c.preview}`);
    console.log('');
  }
}

async function openConversation(tab, name) {
  const raw = await browser.evalAsync(tab, `
    (async () => {
      const rows = [...document.querySelectorAll('[class*="DivItemWrapper"]')];
      const target = rows.find(r => {
        const p = r.querySelector('p');
        return p && p.textContent.trim() === ${JSON.stringify(name)};
      }) || rows.find(r => {
        const p = r.querySelector('p');
        return p && p.textContent.trim().toLowerCase().includes(${JSON.stringify(name.toLowerCase())});
      });
      if (!target) return JSON.stringify({ ok: false });
      target.click();
      return JSON.stringify({ ok: true });
    })()
  `.trim().replace(/\n/g, ' '));
  const res = typeof raw === 'string' ? JSON.parse(raw) : raw;
  if (!res.ok) {
    console.error(`Conversation "${name}" not found. Run "tiktok conversations" to see available names.`);
    process.exit(1);
  }
  await new Promise((r) => setTimeout(r, 2500));
}

async function cmdReadMessages(args) {
  const name = args.join(' ').trim();
  if (!name) { console.error('Usage: tiktok read-messages "<conversation name>"'); process.exit(1); }
  const tab = await ensureMessagesPage();
  await openConversation(tab, name);
  const raw = await browser.evalAsync(tab, `
    (async () => {
      const items = [...document.querySelectorAll('[class*="DivMessageContent"], [class*="MessageItem"], [class*="DivChatItem"]')];
      let bubbles = items.map(el => (el.textContent || '').trim()).filter(Boolean);
      if (!bubbles.length) {
        const pane = document.querySelector('[class*="DivChatBox"], [class*="DivMessageList"], main');
        if (pane) bubbles = [...pane.querySelectorAll('p')].map(p => p.textContent.trim()).filter(Boolean);
      }
      return JSON.stringify(bubbles.slice(-40));
    })()
  `.trim().replace(/\n/g, ' '));
  const msgs = typeof raw === 'string' ? JSON.parse(raw) : raw;
  console.log(`Conversation with "${name}" (last ${msgs.length} messages):\n`);
  for (const m of msgs) console.log(`  ${m.replace(/\n/g, ' ')}`);
}

async function cmdSendMessage(args) {
  const name = args[0];
  const text = args.slice(1).join(' ');
  if (!name || !text) { console.error('Usage: tiktok send-message "<conversation name>" "<message text>"'); process.exit(1); }
  const tab = await ensureMessagesPage();
  // Sending requires the tab to be foregrounded so CDP key events are delivered.
  await exec(`playwright-cli tab-select 1`).catch(() => {});
  await openConversation(tab, name);
  // Focus the composer, type, and send.
  const focused = await browser.evalAsync(tab, `
    (async () => {
      const box = document.querySelector('[contenteditable="true"], textarea, [data-e2e="message-input-area"] [contenteditable]');
      if (!box) return JSON.stringify({ ok: false });
      box.focus();
      return JSON.stringify({ ok: true });
    })()
  `.trim().replace(/\n/g, ' '));
  const f = typeof focused === 'string' ? JSON.parse(focused) : focused;
  if (!f.ok) { console.error('Could not find the message composer. The conversation may not have opened.'); process.exit(1); }
  const { stdout } = await exec(`playwright-cli type ${JSON.stringify(text)}`);
  await new Promise((r) => setTimeout(r, 500));
  await exec(`playwright-cli press Enter`);
  await new Promise((r) => setTimeout(r, 1500));
  // Verify the composer cleared (best-effort).
  const check = await browser.evalAsync(tab, `
    (() => {
      const box = document.querySelector('[contenteditable="true"], textarea');
      return JSON.stringify({ remaining: box ? (box.textContent || box.value || '').trim() : null });
    })()
  `.trim().replace(/\n/g, ' '));
  const c = typeof check === 'string' ? JSON.parse(check) : check;
  if (c.remaining) {
    console.error(`Message may not have sent -- composer still shows: "${c.remaining}". Try running with the TikTok tab in the foreground.`);
    process.exit(1);
  }
  console.log(`Sent to "${name}": ${text}`);
}

// ---------------------------------------------------------------------------
// Raw API escape hatch (like `gh api`)
// ---------------------------------------------------------------------------

async function cmdApi(positional, flags, rawRest) {
  let path = positional[0];
  if (!path) {
    console.error('Usage: tiktok api <path> [--method=GET] [--query k=v ...] [--data \'<json>\'] [--bare] [--raw] [--include]');
    console.error('');
    console.error('Calls any TikTok endpoint from the logged-in, signed page context.');
    console.error('By default the standard web params (aid=1988, device_id, region, ...) are');
    console.error('prepended and the JSON response is pretty-printed. Examples:');
    console.error("  tiktok api /api/item/detail/ --query itemId=7210798564014837035");
    console.error("  tiktok api /api/comment/list/ -q aweme_id=123 -q count=5");
    console.error("  tiktok api /tiktok/v1/analytics/insights/ --bare \\");
    console.error("    --query 'type_requests=[{\"insight_type\":121,\"data_date_range\":1}]' --query time_offset=7200");
    process.exit(1);
  }
  const method = String(flags.method || flags.X || 'GET').toUpperCase();

  // Collect repeated --query / -q k=v (parseArgs keeps only the last, so re-scan).
  const query = {};
  for (let i = 0; i < rawRest.length; i++) {
    let kv = null;
    if ((rawRest[i] === '--query' || rawRest[i] === '-q') && i + 1 < rawRest.length) kv = rawRest[++i];
    else if (rawRest[i].startsWith('--query=')) kv = rawRest[i].slice('--query='.length);
    else if (rawRest[i].startsWith('-q=')) kv = rawRest[i].slice(3);
    if (kv) {
      const eq = kv.indexOf('=');
      if (eq !== -1) query[kv.slice(0, eq)] = kv.slice(eq + 1);
    }
  }

  let body = null;
  const rawBody = flags.data != null ? flags.data : (flags.d != null ? flags.d : null);
  if (rawBody != null && rawBody !== true) {
    try { body = JSON.parse(rawBody); } catch (e) { body = rawBody; }
  }
  const useCommon = !flags.bare;

  const { status, bodyText, data } = await signedRequest({ url: path, method, query, body, useCommon });
  if (flags.include || flags.i) console.error(`HTTP ${status}`);
  if (data != null && !flags.raw) console.log(JSON.stringify(data, null, 2));
  else console.log(bodyText || '');
  if (status >= 400 || (data && data.status_code && data.status_code !== 0)) process.exitCode = 1;
}

// ---------------------------------------------------------------------------
// TikTok Studio (creator analytics)
// ---------------------------------------------------------------------------

const STUDIO_RANGE = { '7d': 1, '28d': 2, '60d': 3, '365d': 4, '7': 1, '28': 2, '60': 3, '365': 4 };
// insight_type -> label (overview metrics)
const STUDIO_OVERVIEW = [
  [121, 'Video views', 'analytics_overview_views'],
  [122, 'Profile views', 'analytics_overview_profile_views'],
  [123, 'Likes', 'analytics_overview_likes'],
  [124, 'Comments', 'analytics_overview_comments'],
  [125, 'Shares', 'analytics_overview_shares'],
  [140, 'New followers', 'analytics_viewer_new_viewer'],
];

function metricSeries(m) {
  if (!m) return null;
  const listNode = m.list || m.new_viewer_list;
  const arr = listNode && Array.isArray(listNode.value) ? listNode.value : [];
  const total = arr.reduce((s, e) => s + (Number(e && e.value) || 0), 0);
  const delta = m.delta_change && m.delta_change.value != null ? Number(m.delta_change.value) : null;
  return { total, delta, days: arr.length };
}

async function cmdStudio(positional, flags) {
  const sub = positional[0] || 'analytics';
  if (sub === 'user') return studioUser();
  if (sub !== 'analytics' && sub !== 'overview') {
    console.error(`Unknown studio subcommand: ${sub}. Use "analytics" or "user".`);
    process.exit(1);
  }
  const rangeKey = String(flags.range || '7d').toLowerCase();
  const dr = STUDIO_RANGE[rangeKey] || 1;
  const rangeLabel = { 1: '7 days', 2: '28 days', 3: '60 days', 4: '365 days' }[dr];

  const typeReqs = STUDIO_OVERVIEW.map(([t]) => ({ insight_type: t, data_date_range: dr }));
  const d = await signedRequest({
    url: '/tiktok/v1/analytics/insights/',
    query: { type_requests: JSON.stringify(typeReqs), time_offset: '7200', is_dark_mode: 'false' },
  });
  if (!d.bodyText) {
    console.error('Error: TikTok returned an empty body (throttled). Wait ~30s and retry, or reload the tab.');
    process.exit(1);
  }
  if (!d.data) { console.error(`Error: could not parse analytics response (HTTP ${d.status}).`); process.exit(1); }
  if (d.data.status_code && d.data.status_code !== 0) {
    console.error(`Error: analytics request failed (status_code ${d.data.status_code}). Make sure you are logged in as a creator and the active tab is www.tiktok.com.`);
    process.exit(1);
  }

  const uid = (d.data && d.data.extra && d.data.extra.logid) ? '' : '';
  console.log(`TikTok Studio analytics — last ${rangeLabel}\n`);
  for (const [, label, key] of STUDIO_OVERVIEW) {
    const s = metricSeries(d.data[key]);
    if (!s) { console.log(`  ${label.padEnd(16)} n/a`); continue; }
    const deltaStr = s.delta == null ? '' : `  (Δ ${s.delta >= 0 ? '+' : ''}${num(s.delta)})`;
    console.log(`  ${label.padEnd(16)} ${num(s.total)}${deltaStr}`);
  }
  console.log(`\n(Totals summed over the ${rangeLabel} window. Use "tiktok api /tiktok/v1/analytics/insights/ ..." for per-day series or other insight_types.)`);
}

async function studioUser() {
  const { status, bodyText, data } = await signedRequest({ url: '/tiktokstudio/api/web/user', useCommon: false });
  if (!bodyText) { console.error('Error: empty response (throttled or not on a studio-capable session). Retry shortly.'); process.exit(1); }
  if (!data) { console.error(`Error: could not parse response (HTTP ${status}): ${bodyText.slice(0, 160)}`); process.exit(1); }
  const base = data.userBaseInfo && data.userBaseInfo.UserProfile && data.userBaseInfo.UserProfile.UserBase;
  console.log(JSON.stringify({
    userId: data.userId,
    isPrivate: data.userExtra && data.userExtra.isPrivate,
    isVerified: data.userExtra && data.userExtra.isVerified,
    bio: data.userExtra && data.userExtra.profileBio,
    region: base && base.Region && base.Region.Region,
    csrfToken: data['tt-csrf-token'] ? '(present)' : undefined,
  }, null, 2));
}

// ---------------------------------------------------------------------------
// Monday protocol -- unified inbox JSON (notifications + unread DMs)
// ---------------------------------------------------------------------------

function mondayFlagsFrom(flags) {
  const limit = parseInt(flags.limit || '50', 10);
  const date = flags.date || '7d';
  const m = String(date).match(/^(\d+)([dwh])$/);
  let oldest = Math.floor(Date.now() / 1000) - 7 * 86400;
  if (m) {
    const n = parseInt(m[1], 10);
    const mult = m[2] === 'w' ? 7 * 86400 : m[2] === 'h' ? 3600 : 86400;
    oldest = Math.floor(Date.now() / 1000) - n * mult;
  }
  return { limit, oldest };
}

const NOTICE_TYPE = {
  1: 'system', 2: 'like', 3: 'comment', 6: 'follow', 12: 'update', 31: 'comment',
  41: 'suggested-account', 43: 'like', 44: 'friend-joined', 45: 'mention',
  56: 'reply', 62: 'comment', 74: 'follow-request', 82: 'mention', 87: 'tag',
};

async function cmdMonday(positional, flags) {
  const { limit, oldest } = mondayFlagsFrom(flags);
  const items = [];

  // 1. Activity feed (notifications), group 500 = all activity.
  try {
    const groupList = JSON.stringify([{ count: Math.min(limit, 50), is_mark_read: 0, group: 500, max_time: 0, min_time: 0 }]);
    const d = await apiGet('/api/notice/multi/', { group_list: groupList, from_page: 'activity' });
    const notices = (d.notice_lists && d.notice_lists[0] && d.notice_lists[0].notice_list) || [];
    for (const n of notices) {
      if (n.create_time && n.create_time < oldest) continue;
      const label = NOTICE_TYPE[n.type] || `type-${n.type}`;
      const dg = n.digg || n.comment || n.follow || n.at || n.mention || {};
      const from = dg.from_user || (dg.user_list && dg.user_list[0]) || n.from_user || {};
      const handle = from.unique_id || from.uid || '';
      let bodyText = '';
      if (n.comment && n.comment.comment) bodyText = n.comment.comment.text || '';
      if (dg.content) bodyText = dg.content;
      items.push({
        source: 'tiktok',
        type: label === 'comment' || label === 'reply' ? 'comment' : (label === 'mention' || label === 'tag' ? 'mention' : 'notification'),
        id: `tiktok-notice-${n.nid_str || n.nid || n.create_time}`,
        title: `${label}${handle ? ' from @' + handle : ''}`,
        body: (bodyText || '').replace(/\n/g, ' ').slice(0, 300),
        url: 'https://www.tiktok.com/notifications',
        from: handle ? '@' + handle : '',
        date: n.create_time ? new Date(n.create_time * 1000).toISOString() : '',
        unread: !n.has_read,
        repo: null,
        number: null,
      });
    }
  } catch (e) {
    console.error(`[tiktok monday] WARNING: failed to fetch notifications: ${e && e.message ? e.message : e}`);
  }

  // 2. Unread DM conversations (rendered messages page).
  try {
    const convs = await readConversationsDom();
    for (const c of convs) {
      const hasUnread = c.unread && c.unread !== '0' && c.unread !== '';
      if (!hasUnread) continue;
      items.push({
        source: 'tiktok',
        type: 'dm',
        id: `tiktok-dm-${c.name}`.replace(/\s+/g, '-'),
        title: `Message from ${c.name}`,
        body: (c.preview || '').replace(/\n/g, ' ').slice(0, 300),
        url: 'https://www.tiktok.com/messages',
        from: c.name,
        date: c.time ? new Date(c.time).toISOString() : '',
        unread: true,
        repo: null,
        number: null,
      });
    }
  } catch (e) {
    console.error(`[tiktok monday] WARNING: failed to fetch messages: ${e && e.message ? e.message : e}`);
  }

  items.sort((a, b) => (b.date > a.date ? 1 : b.date < a.date ? -1 : 0));
  console.log(JSON.stringify(items.slice(0, limit), null, 2));
}

// ---------------------------------------------------------------------------
// Dispatch
// ---------------------------------------------------------------------------

const commands = {
  whoami: cmdWhoami,
  search: cmdSearch,
  video: cmdVideo,
  comments: cmdComments,
  'user-videos': cmdUserVideos,
  posted: cmdUserVideos,
  reposts: cmdReposts,
  liked: cmdLiked,
  favorites: cmdFavorites,
  notifications: cmdNotifications,
  notices: cmdNotifications,
  'notice-count': cmdNoticeCount,
  conversations: cmdConversations,
  messages: cmdConversations,
  'read-messages': cmdReadMessages,
  'send-message': cmdSendMessage,
  api: cmdApi,
  studio: cmdStudio,
  monday: cmdMonday,
};

function parseArgs(argv) {
  const flags = {};
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const eq = a.indexOf('=');
      if (eq !== -1) flags[a.slice(2, eq)] = a.slice(eq + 1);
      else if (i + 1 < argv.length && !argv[i + 1].startsWith('--')) flags[a.slice(2)] = argv[++i];
      else flags[a.slice(2)] = true;
    } else positional.push(a);
  }
  return { flags, positional };
}

const rawArgs = process.argv.slice(2);
const [cmd, ...rest] = rawArgs;

if (!cmd || cmd === 'help' || cmd === '--help') {
  console.log('TikTok web API client — drive TikTok from the command line.\n');
  console.log('Requires a logged-in www.tiktok.com tab open in your browser.\n');
  console.log('Usage: tiktok <command> [args] [flags]\n');
  console.log('Account:');
  console.log('  whoami                                        Show the logged-in TikTok account\n');
  console.log('Search:');
  console.log('  search <query> [--type=general|video|user] [--count=N] [--cursor=N]');
  console.log('                                                Search TikTok (general = mixed feed)\n');
  console.log('Videos & stats:');
  console.log('  video <videoId>                               Full video detail + play/like/comment/share/save stats');
  console.log('  comments <videoId> [--count=N] [--cursor=N]   List comments on a video');
  console.log('  user-videos <secUid> [--count=N] [--cursor=N] List a user\'s posted videos (+stats). Alias: posted\n');
  console.log('Profile tabs (secUid optional — defaults to your own account):');
  console.log('  posted    [<secUid>] [--count=N] [--cursor=N]   Posted videos');
  console.log('  reposts   [<secUid>] [--count=N] [--cursor=N]   Reposted videos');
  console.log('  liked     [<secUid>] [--count=N] [--cursor=N]   Liked videos (usually self-only)');
  console.log('  favorites [<secUid>] [--count=N] [--cursor=N]   Favorited/bookmarked videos (self-only)\n');
  console.log('Notifications:');
  console.log('  notice-count                                  Unread notification counts by group');
  console.log('  notifications [--group=N] [--count=N] [--mark-read] [--cursor=<max_time>]');
  console.log('                                                Activity feed (group 500 = all). Alias: notices\n');
  console.log('Direct messages (rendered via the messages page):');
  console.log('  conversations                                 List DM conversations + previews. Alias: messages');
  console.log('  read-messages "<name>"                        Read the latest messages in a conversation');
  console.log('  send-message "<name>" "<text>"                Send a DM (best run with the TikTok tab focused)\n');
  console.log('Creator analytics (TikTok Studio):');
  console.log('  studio analytics [--range=7d|28d|60d|365d]    Views/likes/comments/shares/followers overview');
  console.log('  studio user                                   Studio creator profile info\n');
  console.log('Aggregation:');
  console.log('  monday [--limit=N] [--date=Nd]                Unified inbox JSON (notifications + unread DMs)\n');
  console.log('Escape hatch (like `gh api`):');
  console.log('  api <path> [--method=GET] [--query k=v ...] [--data \'<json>\'] [--bare] [--raw] [--include]');
  console.log('                                                Call any TikTok endpoint from the signed page context\n');
  console.log('Tip: get a secUid for user-videos via `tiktok search <name> --type=user`.');
  process.exit(0);
}

if (!commands[cmd]) {
  console.error(`Unknown command: ${cmd}`);
  console.error('Run "tiktok help" for usage.');
  process.exit(1);
}

const { flags, positional } = parseArgs(rest);
await commands[cmd](positional, flags, rest);
