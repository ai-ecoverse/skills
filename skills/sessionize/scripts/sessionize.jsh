// Sessionize CFP / speaker client -- generated by secret-sauce.
// Reverse-engineered from /shared/sessionize-recording/submit.har.
//
// AUTH MODEL: Sessionize has NO token/API key. It is session-cookie
// authenticated in the user's logged-in browser. Every call is issued
// SAME-ORIGIN from inside an open sessionize.com tab via browser.fetch to
// relative "/..." paths (cookies + Origin travel automatically). No cookie
// or token is ever read, stored, or forwarded.
//
// See ../references/endpoints.md for the full field/GUID reference and the
// note that `submit` (non-draft) still needs live verification.

const browser = require('sliccy:browser');

const SESSIONIZE_DOMAIN = 'sessionize.com';

// ---------------------------------------------------------------------------
// Tab management
// ---------------------------------------------------------------------------
let _tab = null;

async function findSessionizeTab() {
  if (_tab) return _tab;
  let tab = await browser.findTab({ domain: SESSIONIZE_DOMAIN });
  if (!tab) {
    console.error(
      'Error: No sessionize.com tab found. Open https://sessionize.com in your ' +
      'browser (logged in) and try again.'
    );
    process.exit(1);
  }
  _tab = tab;
  return _tab;
}

// ---------------------------------------------------------------------------
// Validation helpers
// ---------------------------------------------------------------------------
function validateSlug(slug) {
  if (!slug || !/^[A-Za-z0-9][A-Za-z0-9-]*$/.test(slug)) {
    console.error(`Error: invalid event slug "${slug}". Expected the path segment, e.g. "ai-native-devcon-nyc-2026".`);
    process.exit(1);
  }
  return slug;
}

// ---------------------------------------------------------------------------
// Same-origin fetch helpers (run inside the sessionize.com tab)
// ---------------------------------------------------------------------------
async function getPage(path) {
  const tab = await findSessionizeTab();
  const resp = await browser.fetch(tab, path, {
    method: 'GET',
    headers: { Accept: 'text/html' },
  });
  return resp || {};
}

async function postForm(path, bodyString, { referer } = {}) {
  const tab = await findSessionizeTab();
  const headers = {
    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
    'X-FormEx': '1',
    'X-Requested-With': 'XMLHttpRequest',
    Accept: '*/*',
  };
  if (referer) headers.Referer = referer;
  const resp = await browser.fetch(tab, path, {
    method: 'POST',
    headers,
    body: bodyString,
  });
  return resp || {};
}

function detectLoginRedirect(resp) {
  // A logged-out session redirects to a login page or returns the login HTML.
  const body = typeof resp.body === 'string' ? resp.body : '';
  const url = resp.url || '';
  if (/\/app\/(login|signin)|Log in to Sessionize/i.test(url + body)) {
    console.error('Sessionize session appears logged out. Log in at https://sessionize.com and try again.');
    process.exit(1);
  }
}

// ---------------------------------------------------------------------------
// Form scraping: pull tokens + custom-field metadata + tag options from the
// CFP form page HTML. These values are EVENT-SPECIFIC and must be read live.
// ---------------------------------------------------------------------------
function htmlOf(resp) {
  if (typeof resp.body === 'string') return resp.body;
  if (resp.body && typeof resp.body === 'object') return JSON.stringify(resp.body);
  return '';
}

function extractHiddenInputs(html) {
  // Returns { name: value } for every <input type=hidden name=.. value=..>.
  const out = {};
  const re = /<input\b[^>]*>/gi;
  let m;
  while ((m = re.exec(html))) {
    const tag = m[0];
    if (!/type\s*=\s*["']?hidden/i.test(tag)) continue;
    const nameM = tag.match(/\bname\s*=\s*"([^"]*)"/i);
    const valM = tag.match(/\bvalue\s*=\s*"([^"]*)"/i);
    if (nameM) out[nameM[1]] = valM ? decodeHtml(valM[1]) : '';
  }
  return out;
}

function decodeHtml(s) {
  return String(s)
    .replace(/&amp;/g, '&').replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>');
}

function scrapeForm(html) {
  const hidden = extractHiddenInputs(html);

  const token = hidden['__RequestVerificationToken'] || '';
  const formexVerification = hidden['formex-verification'] || '';
  const eventId = hidden['Event.Id'] || '';

  // Custom fields: collect every GUID that appears, plus its Id/Signature/FieldType.
  const fields = {}; // guid -> { id, signature, fieldType, options: {labelLower: id}, label }
  const guidRe = /Fields\.CustomFields\[([0-9a-f-]{36})\]\.(Id|Signature|FieldType)/gi;
  let g;
  while ((g = guidRe.exec(html))) {
    const guid = g[1];
    const prop = g[2];
    fields[guid] = fields[guid] || { id: '', signature: '', fieldType: '', options: {}, label: '' };
    // Find the value for this specific hidden input if present.
    const key = `Fields.CustomFields[${guid}].${prop}`;
    if (hidden[key] !== undefined) {
      if (prop === 'Id') fields[guid].id = hidden[key];
      if (prop === 'Signature') fields[guid].signature = hidden[key];
      if (prop === 'FieldType') fields[guid].fieldType = hidden[key];
    }
  }

  // Tag <option> lists: try to associate <select> blocks that mention a GUID
  // with their option label->value maps. Best-effort HTML parse.
  const selectRe = /<select\b[^>]*name\s*=\s*"([^"]*ValueTagIds[^"]*)"[^>]*>([\s\S]*?)<\/select>/gi;
  let s;
  while ((s = selectRe.exec(html))) {
    const name = s[1];
    const guidM = name.match(/\[([0-9a-f-]{36})\]/i);
    if (!guidM) continue;
    const guid = guidM[1];
    fields[guid] = fields[guid] || { id: '', signature: '', fieldType: 'Tag', options: {}, label: '' };
    const optRe = /<option\b[^>]*value\s*=\s*"([^"]*)"[^>]*>([\s\S]*?)<\/option>/gi;
    let o;
    while ((o = optRe.exec(s[2]))) {
      const val = o[1];
      const label = decodeHtml(o[2].replace(/<[^>]*>/g, '').trim());
      if (val) fields[guid].options[label.toLowerCase()] = val;
    }
  }

  return { hidden, token, formexVerification, eventId, fields };
}

// Match a flag to a custom-field GUID by keyword against scraped field labels,
// falling back to the GUIDs documented for the reference event. Because labels
// are not always reliably scrapable, we also accept explicit --field/--tag.
const REFERENCE_GUIDS = {
  'session-type': '2a2c2a76-0798-4177-966e-a82c6429fb07',
  'primary-track': '67e7454b-cde2-47a4-83aa-d9b111669f68',
  'secondary-track': 'f04e9b6f-e3bd-4aef-a1b5-e935efd9f61a',
  level: '91d73ba0-10d9-4512-974f-c04f806ff4f5',
  takeaways: 'e41b8ee4-8490-4611-bc7d-906eab63919f',
  video: '510277b2-bdca-40ab-ba17-4b190c9a285a',
  tags: 'e361764f-d666-4c5d-b9e9-27cc0eca29fe',
  'in-person': '71c50e00-a300-4e30-99ef-31b090bba27c',
  company: 'd7228853-525a-4715-bc81-bb4f7faa1ecb',
  role: '3d4df803-e071-4629-9906-86ac59cf7ccc',
};

// ---------------------------------------------------------------------------
// Payload builder
// ---------------------------------------------------------------------------
function buildPayload(scrape, flags, slug) {
  const p = new URLSearchParams();
  const add = (k, v) => p.append(k, v == null ? '' : String(v));

  add('__RequestVerificationToken', scrape.token);
  add('formex-submit-button-value', '');
  add('formex-confirmation-value', '');
  add('formex-verification', scrape.formexVerification);
  add('Event.Id', scrape.eventId);
  add('SubmissionExceptionSignature', '');
  add('SessionType', 'New');
  add('Selected_SameSessionIdentifier', '');

  if (flags.title != null) add('Session.Title', flags.title);
  if (flags.description != null) add('Session.Description', flags.description);

  // Resolve which GUID each flag targets.
  const guidFor = (name) => {
    // Prefer a scraped field whose label matches; else fall back to reference GUID
    // if that GUID actually exists on this form.
    if (REFERENCE_GUIDS[name] && scrape.fields[REFERENCE_GUIDS[name]]) return REFERENCE_GUIDS[name];
    const kw = name.replace('-', ' ');
    for (const guid of Object.keys(scrape.fields)) {
      if ((scrape.fields[guid].label || '').toLowerCase().includes(kw)) return guid;
    }
    return REFERENCE_GUIDS[name] || null;
  };

  const customValues = {}; // guid -> { kind:'tag'|'text'|'checkbox', value }
  const setTag = (guid, human) => {
    const f = scrape.fields[guid];
    let id = human;
    if (f && f.options && Object.keys(f.options).length) {
      const resolved = f.options[String(human).toLowerCase()];
      if (resolved) id = resolved;
      else if (!/^\d+$/.test(String(human))) {
        console.error(`Error: tag value "${human}" not valid for field ${guid}.`);
        console.error('Valid options: ' + Object.keys(f.options).join(', '));
        console.error('Or pass the id directly with --tag ' + guid + '=<id>.');
        process.exit(1);
      }
    }
    customValues[guid] = { kind: 'tag', value: id };
  };

  if (flags['session-type'] != null) { const gg = guidFor('session-type'); if (gg) setTag(gg, flags['session-type']); }
  if (flags['primary-track'] != null) { const gg = guidFor('primary-track'); if (gg) setTag(gg, flags['primary-track']); }
  if (flags['secondary-track'] != null) { const gg = guidFor('secondary-track'); if (gg) setTag(gg, flags['secondary-track']); }
  if (flags.level != null) { const gg = guidFor('level'); if (gg) setTag(gg, flags.level); }
  if (flags.takeaways != null) { const gg = guidFor('takeaways'); if (gg) customValues[gg] = { kind: 'text', value: flags.takeaways }; }
  if (flags.video != null) { const gg = guidFor('video'); if (gg) customValues[gg] = { kind: 'text', value: flags.video }; }
  if (flags.company != null) { const gg = guidFor('company'); if (gg) customValues[gg] = { kind: 'text', value: flags.company }; }
  if (flags.role != null) { const gg = guidFor('role'); if (gg) customValues[gg] = { kind: 'text', value: flags.role }; }
  if (flags.tags != null) {
    // Free-tag field: each comma-separated value must be an existing tag id/label.
    const gg = guidFor('tags');
    if (gg) {
      const parts = String(flags.tags).split(',').map((x) => x.trim()).filter(Boolean);
      const f = scrape.fields[gg] || { options: {} };
      const ids = parts.map((part) => {
        const r = f.options[part.toLowerCase()];
        return r || part;
      });
      customValues[gg] = { kind: 'tag', value: ids.join(',') };
    }
  }

  // Explicit overrides
  for (const [guid, value] of flags._tagOverrides) setTag(guid, value);
  for (const [guid, value] of flags._fieldOverrides) customValues[guid] = { kind: 'text', value };

  // Emit every custom field known on the form (index list first, then group).
  const guids = Object.keys(scrape.fields);
  for (const guid of guids) add('Fields.CustomFields.index', guid);
  for (const guid of guids) {
    const f = scrape.fields[guid];
    add(`Fields.CustomFields[${guid}].Id`, f.id);
    add(`Fields.CustomFields[${guid}].Signature`, f.signature);
    add(`Fields.CustomFields[${guid}].FieldType`, f.fieldType);
    const cv = customValues[guid];
    if ((f.fieldType || '').toLowerCase() === 'tag') {
      add(`Fields.CustomFields[${guid}].ValueTagIds`, cv ? cv.value : '');
    } else if ((f.fieldType || '').toLowerCase() === 'checkbox') {
      add(`Fields.CustomFields[${guid}].Value`, cv ? cv.value : 'false');
    } else {
      add(`Fields.CustomFields[${guid}].Value`, cv ? cv.value : '');
    }
  }

  add('Consent', flags.consent ? 'true' : 'false');
  return p.toString();
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------
const commands = {
  // Best-effort: /app/speaker/sessions was NOT in the recording. We fetch the
  // page and surface session titles if present, else say so.
  async sessions() {
    const resp = await getPage('/app/speaker/sessions');
    detectLoginRedirect(resp);
    const html = htmlOf(resp);
    // Heuristic scrape of session titles.
    const titles = [];
    const re = /session\/profile\/edit\/(\d+)"[^>]*>\s*([^<]+)</gi;
    let m;
    while ((m = re.exec(html))) titles.push(`${m[1]}\t${decodeHtml(m[2].trim())}`);
    if (titles.length) {
      console.log('id\ttitle');
      titles.forEach((t) => console.log(t));
    } else {
      console.log('No sessions parsed from /app/speaker/sessions.');
      console.log('(This endpoint was not in the source recording — its shape is unverified.');
      console.log(' Open https://sessionize.com/app/speaker/sessions in your browser to confirm.)');
    }
  },

  async events() {
    console.log('No confirmed JSON "list CFPs" endpoint exists in the source recording.');
    console.log('Sessionize CFPs are reached directly by their public URL:');
    console.log('  https://sessionize.com/<event-slug>/');
    console.log('');
    console.log('To inspect a specific CFP form, run:  sessionize show <event-slug>');
    console.log('To submit to one, run:                sessionize submit <event-slug> [flags]');
  },

  async cfps(args, flags) { return commands.events(args, flags); },

  async show(args) {
    const slug = validateSlug(args[0]);
    const resp = await getPage(`/${slug}/`);
    detectLoginRedirect(resp);
    const html = htmlOf(resp);
    const scrape = scrapeForm(html);
    if (!scrape.eventId && !Object.keys(scrape.fields).length) {
      console.error(`Could not scrape a submission form at /${slug}/. Is the slug correct and the CFP open?`);
      process.exit(1);
    }
    console.log(`Event.Id: ${scrape.eventId || '(not found)'}`);
    console.log(`__RequestVerificationToken: ${scrape.token ? '(present)' : '(MISSING)'}`);
    console.log(`formex-verification: ${scrape.formexVerification ? '(present)' : '(MISSING)'}`);
    console.log(`\nCustom fields (${Object.keys(scrape.fields).length}):`);
    for (const [guid, f] of Object.entries(scrape.fields)) {
      const opts = Object.keys(f.options || {});
      console.log(`  ${guid}  Id=${f.id} type=${f.fieldType}${opts.length ? '  options=[' + opts.join(', ') + ']' : ''}`);
    }
  },

  async submit(args, flags) {
    const slug = validateSlug(args[0]);
    const referer = `https://sessionize.com/${slug}/`;

    // 1. Scrape the live form for tokens + field metadata + tag options.
    const pageResp = await getPage(`/${slug}/`);
    detectLoginRedirect(pageResp);
    const scrape = scrapeForm(htmlOf(pageResp));
    if (!scrape.token || !scrape.formexVerification || !scrape.eventId) {
      console.error('Could not scrape the anti-forgery tokens / Event.Id from the form page.');
      console.error('The form HTML shape may have changed, or you are not logged in / the CFP is closed.');
      console.error('Run `sessionize show ' + slug + '` to inspect what was scraped.');
      process.exit(1);
    }

    // 2. Build the payload.
    const body = buildPayload(scrape, flags, slug);

    // 3. POST to draft (safe) or the real submit endpoint.
    const path = flags.draft ? '/submission-draft' : `/submission/${slug}`;
    // Draft wraps everything in data=<urlencoded-json-or-form>; the direct
    // form-pair shape matched the observed 200 responses, so we post that.
    const resp = await postForm(path, body, { referer });

    const data = resp.body;
    if (flags.json) {
      console.log(typeof data === 'string' ? data : JSON.stringify(data, null, 2));
      return;
    }

    if (data && typeof data === 'object' && data.ValidationErrors && Object.keys(data.ValidationErrors).length) {
      console.error((flags.draft ? 'Draft' : 'Submit') + ' returned validation errors:');
      for (const [k, v] of Object.entries(data.ValidationErrors)) console.error(`  - ${k}: ${v}`);
      process.exit(2);
    }
    if (flags.draft) {
      console.log('Draft auto-saved (status ' + (resp.status || '?') + ').');
      return;
    }
    if (data && typeof data === 'object' && (data.Success || data.RedirectTo || data.ConfirmationMessages)) {
      console.log('Submitted. Response:');
      console.log(JSON.stringify(data, null, 2));
    } else {
      console.log('Submit returned status ' + (resp.status || '?') + '. Raw response:');
      console.log(typeof data === 'string' ? data.slice(0, 2000) : JSON.stringify(data, null, 2));
      console.log('\nNote: a clean accepted submit was never observed in the source recording — verify in the UI.');
    }
  },
};

// ---------------------------------------------------------------------------
// Flag parsing
//   - long flags with values: --title "x" or --title=x
//   - boolean flags (single-token): --draft --consent --json
//   - repeatable: --field <guid>=<value>, --tag <guid>=<label|id>
// ---------------------------------------------------------------------------
const BOOLEAN_FLAGS = new Set(['draft', 'consent', 'json']);
const VALUE_FLAGS = new Set([
  'title', 'description', 'session-type', 'primary-track', 'secondary-track',
  'level', 'takeaways', 'video', 'tags', 'company', 'role',
]);

function parseFlags(argv) {
  const flags = { _tagOverrides: [], _fieldOverrides: [] };
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      let name = a.slice(2);
      let val = null;
      const eq = name.indexOf('=');
      if (eq !== -1) { val = name.slice(eq + 1); name = name.slice(0, eq); }

      if (BOOLEAN_FLAGS.has(name)) { flags[name] = true; continue; }

      if (name === 'field' || name === 'tag') {
        if (val == null) val = argv[++i];
        const m = String(val || '').match(/^([0-9a-f-]{36})=(.*)$/i);
        if (!m) { console.error(`Error: --${name} expects <guid>=<value>.`); process.exit(1); }
        (name === 'tag' ? flags._tagOverrides : flags._fieldOverrides).push([m[1], m[2]]);
        continue;
      }

      if (VALUE_FLAGS.has(name)) {
        if (val == null) val = argv[++i];
        if (val == null) { console.error(`Error: --${name} requires a value.`); process.exit(1); }
        flags[name] = val;
        continue;
      }
      console.error(`Unknown flag: --${name}`);
      process.exit(1);
    } else {
      positional.push(a);
    }
  }
  return { flags, positional };
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
async function main() {
  const rawArgs = process.argv.slice(2);
  const [cmd, ...rest] = rawArgs;

  if (!cmd || cmd === 'help' || cmd === '--help') {
    console.log('Sessionize CFP / speaker client — same-origin via your logged-in browser tab.\n');
    console.log('Usage: sessionize <command> [args] [flags]\n');
    console.log('Commands:');
    console.log('  sessions                       List your speaker sessions (best-effort, unverified)');
    console.log('  events | cfps                  Info on listing CFPs (no confirmed list endpoint)');
    console.log('  show <event-slug>              Scrape a CFP form: tokens, custom fields, tag options');
    console.log('  submit <event-slug> [flags]    Build the submission payload and POST it');
    console.log('');
    console.log('submit flags:');
    console.log('  --title, --description, --session-type, --primary-track,');
    console.log('  --secondary-track, --level, --takeaways, --video, --tags "a,b",');
    console.log('  --company, --role');
    console.log('  --consent                      set acceptance checkbox true');
    console.log('  --draft                        only auto-save (/submission-draft), no real submit');
    console.log('  --field <guid>=<value>         set a text custom field by GUID (repeatable)');
    console.log('  --tag <guid>=<label|id>        set a Tag custom field by GUID (repeatable)');
    console.log('  --json                         print raw JSON response');
    console.log('\nAuth: log in to https://sessionize.com in your browser first.');
    console.log('Note: `submit` (non-draft) needs live verification — prefer --draft first.');
    process.exit(0);
  }

  if (!commands[cmd]) {
    console.error(`Unknown command: ${cmd}`);
    console.error('Run "sessionize help" for usage.');
    process.exit(1);
  }

  const { flags, positional } = parseFlags(rest);
  await commands[cmd](positional, flags);
}

await main();
