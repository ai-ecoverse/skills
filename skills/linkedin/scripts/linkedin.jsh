// LinkedIn API client — generated by secret-sauce
// Posts to and manages the AI Ecoverse company page via Voyager GraphQL API
//
// Usage:
//   linkedin post <text>               Publish a text post
//   linkedin list [--limit N]          List recent posts with engagement stats
//   linkedin comments <activityId>     View comments on a post
//   linkedin comment <activityId> <text>  Reply to a post as the company page
//   linkedin reactions <activityId>    View reactions on a post
//   linkedin profile <vanityName>      Quick preview of a LinkedIn profile
//   linkedin monday [--limit N] [--date Nd]  Monday protocol aggregation
//   linkedin help                      Show this help

const COMPANY_URN = 'urn:li:fsd_company:122314561';
const COMPANY_ID = '122314561';
const LINKEDIN_DOMAIN = 'www.linkedin.com';
const GRAPHQL_CREATE_QUERY_ID = 'voyagerContentcreationDashShares.279996efa5064c01775d5aff003d9377';
const GRAPHQL_LIST_QUERY_ID = 'voyagerFeedDashOrganizationalPageAdminUpdates.96fdd4f5900fb8a434c2a3286b1952c2';
const GRAPHQL_COMMENTS_QUERY_ID = 'voyagerSocialDashComments.afec6d88d7810d45548797a8dac4fb87';
const COMMENT_CREATE_DECORATION = 'com.linkedin.voyager.dash.deco.social.NormComment-43';
const PROFILE_DECORATION = 'com.linkedin.voyager.dash.deco.identity.profile.FullProfileWithEntities-118';

// ─── Argument Parsing ────────────────────────────────────────────────────────

const rawArgs = process.argv.slice(2);
const cmd = rawArgs[0] || '';
const positional = [];
const flags = {};

for (var i = 1; i < rawArgs.length; i++) {
  var arg = rawArgs[i];
  if (arg.startsWith('--')) {
    var eq = arg.indexOf('=');
    if (eq !== -1) {
      flags[arg.slice(2, eq)] = arg.slice(eq + 1);
    } else {
      var key = arg.slice(2);
      if (i + 1 < rawArgs.length && !rawArgs[i + 1].startsWith('--')) {
        flags[key] = rawArgs[++i];
      } else {
        flags[key] = 'true';
      }
    }
  } else {
    positional.push(arg);
  }
}

// ─── Tab Management ──────────────────────────────────────────────────────────

var _tabId = null;

async function ensureTab() {
  if (_tabId) return _tabId;

  var list = await exec('playwright-cli tab-list');
  var match = list.stdout.match(/\[([A-F0-9]+)\]\s+https?:\/\/[^\s]*linkedin\.com/);
  if (match) {
    _tabId = match[1];
    return _tabId;
  }

  var r = await exec('playwright-cli open https://www.linkedin.com/company/' + COMPANY_ID + '/admin/page-posts/published/');
  var m = r.stdout.match(/targetId:\s*(\S+)\]/);
  _tabId = m ? m[1] : null;
  if (!_tabId) {
    console.error('Failed to open LinkedIn tab. Ensure LinkedIn is accessible.');
    process.exit(1);
  }

  await new Promise(function(resolve) { setTimeout(resolve, 3000); });
  return _tabId;
}

// ─── CSRF Token ──────────────────────────────────────────────────────────────

async function getCsrfToken(tabId) {
  var r = await exec('playwright-cli cookie-get JSESSIONID --tab=' + tabId);
  var raw = r.stdout.trim();
  var match = raw.match(/JSESSIONID="([^"]+)"/);
  var token = match ? match[1] : raw.replace(/^"|"$/g, '');
  if (!token || token === 'undefined') {
    console.error('No JSESSIONID cookie found. Please log into LinkedIn in your browser.');
    process.exit(1);
  }
  return token;
}

// ─── Page Context API Helper ─────────────────────────────────────────────────

async function pageContextFetch(tabId, csrfToken, url, options) {
  var method = (options && options.method) || 'GET';
  var body = (options && options.body) ? JSON.stringify(options.body) : 'undefined';

  var jsCode = [
    '(async () => {',
    '  var opts = {',
    '    method: "' + method + '",',
    '    credentials: "include",',
    '    headers: {',
    '      "csrf-token": "' + csrfToken + '",',
    '      "x-restli-protocol-version": "2.0.0",',
    '      "accept": "application/vnd.linkedin.normalized+json+2.1",',
    '      "x-li-lang": "en_US"',
    method === 'POST' ? '      ,"content-type": "application/json; charset=UTF-8"' : '',
    method === 'POST' ? '      ,"x-li-pem-metadata": "Voyager - Sharing - CreateShare=sharing-create-content,Voyager - Organization - Admin=organization-create-post-as-page"' : '',
    '    }',
    body !== 'undefined' ? '    ,body: ' + JSON.stringify(body) : '',
    '  };',
    '  var resp = await fetch("' + url.replace(/"/g, '\\"') + '", opts);',
    '  var text = await resp.text();',
    '  if (!resp.ok) return JSON.stringify({ __error: resp.status, detail: text.substring(0, 500) });',
    '  return text;',
    '})()'
  ].join(' ');

  var result = await exec('playwright-cli eval --tab=' + tabId + ' ' + JSON.stringify(jsCode));
  if (result.exitCode !== 0) {
    throw new Error('Eval failed: ' + result.stderr);
  }

  var parsed = JSON.parse(result.stdout.trim());
  if (parsed && parsed.__error) {
    if (parsed.__error === 401 || parsed.__error === 403) {
      console.error('Auth failed (' + parsed.__error + '). Please log into LinkedIn in your browser.');
      process.exit(1);
    }
    throw new Error('API error ' + parsed.__error + ': ' + parsed.detail);
  }

  return parsed;
}

// ─── Commands ────────────────────────────────────────────────────────────────

// --- POST ---

async function createPost(text) {
  var tabId = await ensureTab();
  var csrfToken = await getCsrfToken(tabId);

  var payload = {
    variables: {
      post: {
        allowedCommentersScope: 'ALL',
        intendedShareLifeCycleState: 'PUBLISHED',
        origin: 'ORGANIZATION',
        visibilityDataUnion: { visibilityType: 'ANYONE' },
        commentary: { text: text, attributesV2: [] },
        nonMemberActorUrn: COMPANY_URN
      }
    },
    queryId: GRAPHQL_CREATE_QUERY_ID,
    includeWebMetadata: true
  };

  var url = '/voyager/api/graphql?action=execute&queryId=' + GRAPHQL_CREATE_QUERY_ID;
  var data = await pageContextFetch(tabId, csrfToken, url, { method: 'POST', body: payload });

  var shareData = data && data.data && data.data.data && data.data.data.createContentcreationDashShares;
  var shareUrn = (shareData && (shareData.resourceKey || shareData['*entity'])) || 'unknown';

  return { success: true, shareUrn: shareUrn, url: 'https://www.linkedin.com/feed/update/' + shareUrn };
}

// --- LIST ---

async function listPosts(limit) {
  var tabId = await ensureTab();
  var csrfToken = await getCsrfToken(tabId);
  var count = limit || 10;

  var url = '/voyager/api/graphql?includeWebMetadata=true&variables=(organizationalPageFeedUseCase:ADMIN_ORGANIZATIONAL_PAGE_POSTS,organizationalPageIdOrUniversalName:(organizationalPageUUId:' + COMPANY_ID + '),start:0,count:' + count + ')&queryId=' + GRAPHQL_LIST_QUERY_ID;

  var data = await pageContextFetch(tabId, csrfToken, url);

  var posts = [];
  var activityCounts = {};

  // Extract social activity counts
  if (data.included) {
    data.included.forEach(function(item) {
      if (item.entityUrn && item.entityUrn.startsWith('urn:li:fsd_socialActivityCounts:')) {
        var actId = item.entityUrn.replace('urn:li:fsd_socialActivityCounts:', '');
        activityCounts[actId] = {
          comments: item.numComments || 0,
          reposts: item.numShares || 0,
          likes: item.numLikes || 0,
          reactions: item.reactionTypeCounts || []
        };
      }
    });

    // Extract posts with commentary (exclude comments — they have threadUrn or fsd_comment in entityUrn)
    data.included.forEach(function(item) {
      if (item.commentary && item.commentary.text) {
        // Skip comments (they show up in included but aren't posts)
        if (item.entityUrn && item.entityUrn.includes('fsd_comment')) return;
        if (item.threadUrn) return;

        var text = typeof item.commentary.text === 'string' ? item.commentary.text : item.commentary.text.text;
        if (!text) return;

        // Find the activity URN associated with this update
        var activityUrn = '';
        if (item.entityUrn) {
          var actMatch = item.entityUrn.match(/urn:li:activity:\d+/);
          if (actMatch) activityUrn = actMatch[0];
        }

        var stats = activityCounts[activityUrn] || {};

        posts.push({
          activityUrn: activityUrn,
          text: text,
          comments: stats.comments || 0,
          reposts: stats.reposts || 0,
          likes: stats.likes || 0,
          url: activityUrn ? 'https://www.linkedin.com/feed/update/' + activityUrn : ''
        });
      }
    });
  }

  return { total: posts.length, posts: posts };
}

// --- COMMENTS ---

async function getComments(activityId) {
  var tabId = await ensureTab();
  var csrfToken = await getCsrfToken(tabId);

  // Normalize activity ID — accept "7463311119181312000" or "urn:li:activity:7463311119181312000"
  if (!activityId.startsWith('urn:li:activity:')) {
    activityId = 'urn:li:activity:' + activityId;
  }

  // LinkedIn RESTLI format: outer parens/commas are literal, but URN colons and inner parens are percent-encoded
  var encodedActivity = activityId.replace(/:/g, '%3A');
  var encodedCompanyUrn = COMPANY_URN.replace(/:/g, '%3A');
  var socialDetailEncoded = 'urn%3Ali%3Afsd_socialDetail%3A%28' + encodedActivity + '%2C' + encodedActivity + '%2Curn%3Ali%3AhighlightedReply%3A-%29';
  var url = '/voyager/api/graphql?includeWebMetadata=true&variables=(count:20,numReplies:3,nonMemberActorUrn:' + encodedCompanyUrn + ',socialDetailUrn:' + socialDetailEncoded + ',sortOrder:RELEVANCE,start:0)&queryId=' + GRAPHQL_COMMENTS_QUERY_ID;

  var data = await pageContextFetch(tabId, csrfToken, url);

  var comments = [];
  if (data.included) {
    data.included.forEach(function(item) {
      if (item.commentary && item.commentary.text && item.commenter) {
        var text = typeof item.commentary.text === 'string' ? item.commentary.text : item.commentary.text.text;
        var commenterName = '';
        var commenterUrn = '';

        // Try to resolve commenter info from included data
        if (item.commenter && item.commenter.actorUrn) {
          commenterUrn = item.commenter.actorUrn;
          // Try to find name in included
          data.included.forEach(function(inc) {
            if (inc.entityUrn === commenterUrn || (inc.entityUrn && inc.entityUrn.includes(commenterUrn))) {
              commenterName = (inc.firstName ? inc.firstName + ' ' + inc.lastName : inc.name) || '';
            }
          });
        }

        comments.push({
          commentUrn: item.entityUrn || '',
          text: text,
          commenter: commenterName || commenterUrn,
          createdAt: item.createdTime || null
        });
      }
    });
  }

  return { activityId: activityId, total: comments.length, comments: comments };
}

// --- COMMENT (create) ---

async function addComment(activityId, text) {
  var tabId = await ensureTab();
  var csrfToken = await getCsrfToken(tabId);

  if (!activityId.startsWith('urn:li:activity:')) {
    activityId = 'urn:li:activity:' + activityId;
  }

  var payload = {
    commentary: {
      text: text,
      attributesV2: [],
      '$type': 'com.linkedin.voyager.dash.common.text.TextViewModel'
    },
    threadUrn: activityId,
    nonMemberActorUrn: COMPANY_URN
  };

  var url = '/voyager/api/voyagerSocialDashNormComments?decorationId=' + COMMENT_CREATE_DECORATION;
  var data = await pageContextFetch(tabId, csrfToken, url, { method: 'POST', body: payload });

  var commentUrn = (data && data.data && data.data.entityUrn) || 'created';
  return { success: true, commentUrn: commentUrn, activityId: activityId };
}

// --- REACTIONS ---

async function getReactions(activityId) {
  var tabId = await ensureTab();
  var csrfToken = await getCsrfToken(tabId);

  if (!activityId.startsWith('urn:li:activity:')) {
    activityId = 'urn:li:activity:' + activityId;
  }

  // Reactions are included in the feed listing data via socialActivityCounts
  // For detailed per-reactor breakdown, we use the reactors endpoint
  var encodedActivity2 = activityId.replace(/:/g, '%3A');
  var socialDetailEncoded2 = 'urn%3Ali%3Afsd_socialDetail%3A%28' + encodedActivity2 + '%2C' + encodedActivity2 + '%2Curn%3Ali%3AhighlightedReply%3A-%29';
  var url = '/voyager/api/graphql?includeWebMetadata=true&variables=(count:20,socialDetailUrn:' + socialDetailEncoded2 + ',start:0)&queryId=voyagerSocialDashReactors.78aa0bb67da9cc9ca4d58fd093d72e6b';

  try {
    var data = await pageContextFetch(tabId, csrfToken, url);

    var reactors = [];
    if (data.included) {
      data.included.forEach(function(item) {
        if (item.reactorLockup || item.reactionType) {
          reactors.push({
            name: item.title || item.name || '',
            reactionType: item.reactionType || 'LIKE',
            entityUrn: item.entityUrn || ''
          });
        }
        // Also look for profile-like entries that are reactors
        if (item.firstName && item.lastName && !item.commentary) {
          reactors.push({
            name: item.firstName + ' ' + item.lastName,
            headline: item.headline || '',
            entityUrn: item.entityUrn || ''
          });
        }
      });
    }

    return { activityId: activityId, total: reactors.length, reactors: reactors };
  } catch (e) {
    // Fall back to just showing counts from the feed
    var listData = await listPosts(20);
    var post = listData.posts.find(function(p) { return p.activityUrn === activityId; });
    if (post) {
      return { activityId: activityId, likes: post.likes, comments: post.comments, reposts: post.reposts };
    }
    throw e;
  }
}

// --- PROFILE ---

async function getProfile(identifier) {
  var tabId = await ensureTab();
  var csrfToken = await getCsrfToken(tabId);

  // If it's a URN, use directly. If it's a vanity name, navigate and extract.
  if (identifier.startsWith('ACoA') || identifier.startsWith('urn:li:')) {
    // It's a member URN — query directly
    var memberUrn = identifier.replace('urn:li:fsd_profile:', '').replace('urn:li:member:', '');
    return await fetchProfileByUrn(tabId, csrfToken, memberUrn);
  }

  // It's a vanity name — navigate to the profile and extract data from the page
  var profileUrl = 'https://www.linkedin.com/in/' + identifier + '/';
  await exec('playwright-cli goto ' + profileUrl + ' --tab=' + tabId);
  await new Promise(function(resolve) { setTimeout(resolve, 3000); });

  // Get the snapshot for structured data
  var snap = await exec('playwright-cli snapshot --tab=' + tabId);
  var lines = snap.stdout.split('\n');

  var profile = { vanityName: identifier, url: profileUrl };

  // Parse key info from accessibility tree
  for (var j = 0; j < lines.length; j++) {
    var line = lines[j];
    if (line.includes('heading') && !profile.name && j < 30) {
      var nameMatch = line.match(/heading "([^"]+)"/);
      if (nameMatch && !nameMatch[1].includes('navigation') && !nameMatch[1].includes('notification')) {
        profile.name = nameMatch[1];
      }
    }
    if (line.includes('text "') && profile.name && !profile.headline) {
      var headlineMatch = line.match(/text "([^"]+)"/);
      if (headlineMatch && headlineMatch[1].length > 5 && headlineMatch[1].length < 200 && !headlineMatch[1].includes('notification')) {
        profile.headline = headlineMatch[1];
      }
    }
  }

  // Also try to extract the member URN from the page to get full data
  var urnResult = await exec('playwright-cli eval --tab=' + tabId + ' "(() => { var html = document.body.innerHTML; var m = html.match(/ACoA[A-Za-z0-9_-]{30,50}/); return m ? m[0] : null; })()"');
  var memberUrnFromPage = urnResult.stdout.trim();

  if (memberUrnFromPage && memberUrnFromPage !== 'null') {
    try {
      var fullProfile = await fetchProfileByUrn(tabId, csrfToken, memberUrnFromPage);
      return Object.assign(profile, fullProfile);
    } catch (e) {
      // Fall back to snapshot data
    }
  }

  return profile;
}

async function fetchProfileByUrn(tabId, csrfToken, memberUrn) {
  var url = '/voyager/api/identity/dash/profiles?q=memberIdentity&memberIdentity=' + memberUrn + '&decorationId=' + PROFILE_DECORATION;
  var data = await pageContextFetch(tabId, csrfToken, url);

  var profile = {};
  if (data.included) {
    // Find main profile object
    data.included.forEach(function(item) {
      if (item.firstName && item.entityUrn && item.entityUrn.includes(memberUrn)) {
        profile.name = item.firstName + ' ' + item.lastName;
        profile.firstName = item.firstName;
        profile.lastName = item.lastName;
        profile.headline = item.headline || '';
        profile.publicIdentifier = item.publicIdentifier || '';
        profile.industryName = item.industryName || '';
        profile.geoLocationName = item.geoLocationName || '';
        profile.summary = item.summary || '';
        profile.url = 'https://www.linkedin.com/in/' + (item.publicIdentifier || memberUrn) + '/';
        profile.memberUrn = memberUrn;
      }
    });

    // Extract positions/experience
    var positions = [];
    data.included.forEach(function(item) {
      if (item.title && item.companyName && item.entityUrn && item.entityUrn.includes('profilePosition')) {
        positions.push({
          title: item.title,
          company: item.companyName,
          current: !item.timePeriod || !item.timePeriod.endDate
        });
      }
    });
    if (positions.length > 0) profile.positions = positions;
  }

  return profile;
}

// --- MONDAY PROTOCOL ---

async function monday() {
  var limit = parseInt(flags['limit'] || '20');
  var dateStr = flags['date'] || '7d';

  // Parse date into a cutoff timestamp
  var dateMatch = dateStr.match(/^(\d+)([dwh])$/);
  var cutoffMs = Date.now();
  if (dateMatch) {
    var n = parseInt(dateMatch[1]);
    var unit = dateMatch[2];
    var multiplier = unit === 'w' ? 7 * 86400000 : unit === 'h' ? 3600000 : 86400000;
    cutoffMs = Date.now() - n * multiplier;
  } else {
    cutoffMs = Date.now() - 7 * 86400000;
  }

  var tabId = await ensureTab();
  var csrfToken = await getCsrfToken(tabId);

  var items = [];

  // Fetch recent posts with engagement
  try {
    var postData = await listPosts(limit);
    for (var k = 0; k < postData.posts.length; k++) {
      var post = postData.posts[k];
      // Include posts that have new comments or reactions
      if (post.comments > 0 || post.likes > 0 || post.reposts > 0) {
        items.push({
          source: 'linkedin',
          type: 'engagement',
          id: 'linkedin-engagement-' + post.activityUrn,
          title: 'LinkedIn post engagement: ' + post.comments + ' comments, ' + post.likes + ' likes, ' + post.reposts + ' reposts',
          body: post.text,
          url: post.url,
          from: 'AI Ecoverse page',
          date: new Date().toISOString(),
          comments: post.comments,
          likes: post.likes,
          reposts: post.reposts
        });
      }
    }
  } catch (e) {
    console.error('[linkedin monday] WARNING: failed to fetch posts: ' + e.message);
  }

  // Fetch unread comments across recent posts
  try {
    var recentPosts = await listPosts(5);
    for (var m = 0; m < recentPosts.posts.length; m++) {
      var p = recentPosts.posts[m];
      if (p.comments > 0 && p.activityUrn) {
        var commentsData = await getComments(p.activityUrn);
        for (var c = 0; c < commentsData.comments.length; c++) {
          var comment = commentsData.comments[c];
          items.push({
            source: 'linkedin',
            type: 'comment',
            id: 'linkedin-comment-' + (comment.commentUrn || c),
            title: 'Comment on AI Ecoverse post from ' + (comment.commenter || 'someone'),
            body: comment.text,
            url: p.url,
            from: comment.commenter || 'unknown',
            date: comment.createdAt ? new Date(comment.createdAt).toISOString() : new Date().toISOString()
          });
        }
      }
    }
  } catch (e) {
    console.error('[linkedin monday] WARNING: failed to fetch comments: ' + e.message);
  }

  return items;
}

// ─── CLI Dispatch ────────────────────────────────────────────────────────────

if (!cmd || cmd === 'help') {
  console.log('Usage: linkedin <command> [args] [--flags]');
  console.log('');
  console.log('Commands:');
  console.log('  post <text>                  Publish a text post to the AI Ecoverse company page');
  console.log('  list [--limit N]             List recent posts with engagement stats');
  console.log('  comments <activityId>        View comments on a post');
  console.log('  comment <activityId> <text>  Reply to a post as the company page');
  console.log('  reactions <activityId>       View reactions/likes on a post');
  console.log('  profile <vanityName|urn>     Quick preview of a LinkedIn profile');
  console.log('  monday [--limit N] [--date]  Monday protocol: fetch inbox as JSON');
  console.log('  help                         Show this help');
  console.log('');
  console.log('Examples:');
  console.log('  linkedin post "Hello world! #AIEcoverse"');
  console.log('  linkedin list --limit 5');
  console.log('  linkedin comments 7463311119181312000');
  console.log('  linkedin comment 7463311119181312000 "Thanks for the feedback!"');
  console.log('  linkedin reactions 7463311119181312000');
  console.log('  linkedin profile klimetschek');
  console.log('  linkedin monday --limit 20 --date 3d');
  process.exit(cmd === 'help' ? 0 : 1);
}

var result;

if (cmd === 'post') {
  var text = positional.join(' ');
  if (!text) { console.error('Usage: linkedin post <text>'); process.exit(1); }
  result = await createPost(text);
} else if (cmd === 'list') {
  result = await listPosts(parseInt(flags['limit'] || '10'));
} else if (cmd === 'comments') {
  var actId = positional[0];
  if (!actId) { console.error('Usage: linkedin comments <activityId>'); process.exit(1); }
  result = await getComments(actId);
} else if (cmd === 'comment') {
  var actId2 = positional[0];
  var commentText = positional.slice(1).join(' ');
  if (!actId2 || !commentText) { console.error('Usage: linkedin comment <activityId> <text>'); process.exit(1); }
  result = await addComment(actId2, commentText);
} else if (cmd === 'reactions') {
  var actId3 = positional[0];
  if (!actId3) { console.error('Usage: linkedin reactions <activityId>'); process.exit(1); }
  result = await getReactions(actId3);
} else if (cmd === 'profile') {
  var ident = positional[0];
  if (!ident) { console.error('Usage: linkedin profile <vanityName|memberUrn>'); process.exit(1); }
  result = await getProfile(ident);
} else if (cmd === 'monday') {
  result = await monday();
} else {
  console.error('Unknown command: ' + cmd);
  console.error('Run "linkedin help" for usage.');
  process.exit(1);
}

console.log(JSON.stringify(result, null, 2));
