// ServiceNow (Adobe ESC) API client — generated by secret-sauce
// Uses eval-file pattern for page-context API calls via Angular $http
// Dynamic user resolution — run `servicenow login` to authenticate.

const CONFIG_FILE = '/workspace/skills/servicenow/.config.json';
const TICKET_WIDGET = 'a54beb3a87f10010e0ef0cf888cb0bba';

// Defaults (can be overridden in config)
const DEFAULTS = {
  domain: 'adobe.service-now.com',
  portal_id: '70cd9f3b734b13001fdae9c54cf6a72f',
  coveo_org: 'adobev2prod9e382h1q',
  coveo_search_hub: 'ServiceNowESC_MainSearch'
};

let _config = null;
let _tabId = null;

async function loadConfig() {
  if (_config) return _config;
  try {
    const raw = await fs.readFile(CONFIG_FILE, 'utf8');
    _config = JSON.parse(raw);
    return _config;
  } catch (e) {
    return null;
  }
}

async function saveConfig(config) {
  _config = config;
  await fs.writeFile(CONFIG_FILE, JSON.stringify(config, null, 2));
}

function getDomain() {
  return (_config && _config.domain) || DEFAULTS.domain;
}

function getPortalId() {
  return (_config && _config.portal_id) || DEFAULTS.portal_id;
}

function getCoveoOrg() {
  return (_config && _config.coveo_org) || DEFAULTS.coveo_org;
}

function getCoveoSearchHub() {
  return (_config && _config.coveo_search_hub) || DEFAULTS.coveo_search_hub;
}

function getUserSysId() {
  if (_config && _config.user_sys_id) return _config.user_sys_id;
  return null;
}

async function ensureTab() {
  const domain = getDomain();
  if (_tabId) {
    const list = await exec('playwright-cli tab-list');
    if (list.stdout.includes(_tabId)) return _tabId;
    _tabId = null;
  }
  const list = await exec('playwright-cli tab-list');
  const re = new RegExp('\\[([A-F0-9]+)\\]\\s+https?://[^\\s]*' + domain.replace(/\./g, '\\.'));
  const match = list.stdout.match(re);
  if (match) {
    _tabId = match[1];
    return _tabId;
  }
  const r = await exec('playwright-cli open https://' + domain + '/esc');
  const m = r.stdout.match(/targetId:\s*(\S+)\]/);
  _tabId = m ? m[1] : null;
  if (!_tabId) {
    console.error('Failed to open ServiceNow tab.');
    process.exit(1);
  }
  await new Promise(resolve => setTimeout(resolve, 4000));
  return _tabId;
}

// Ensure user is authenticated — if no config, prompt to run login
async function ensureAuth() {
  const config = await loadConfig();
  if (!config || !config.user_sys_id) {
    console.error('Not logged in. Run `servicenow login` first to authenticate.');
    process.exit(1);
  }
  return config;
}

// Evaluate JS in the ServiceNow page context via temp file
async function evalInPage(jsCode) {
  const tabId = await ensureTab();
  const tmpFile = '/shared/.sn_eval_' + Date.now() + '_' + Math.random().toString(36).slice(2) + '.js';
  await fs.writeFile(tmpFile, jsCode);
  const result = await exec('playwright-cli eval-file ' + tmpFile + ' --tab=' + tabId);
  await fs.rm(tmpFile).catch(() => {});

  if (result.exitCode !== 0) {
    if (result.stderr.includes('angular') || result.stderr.includes('injector')) {
      console.error('Session expired or page not loaded. Log into adobe.service-now.com and try again.');
      process.exit(1);
    }
    throw new Error('Eval failed: ' + result.stderr);
  }

  const stdout = result.stdout.trim();
  if (!stdout) return null;
  try {
    let data = JSON.parse(stdout);
    if (typeof data === 'string') data = JSON.parse(data);
    return data;
  } catch (e) {
    return stdout;
  }
}

// Detect if the user is logged in by checking if Angular is loaded and $http works
async function checkLoggedIn() {
  const tabId = await ensureTab();
  const tmpFile = '/shared/.sn_login_check_' + Date.now() + '.js';
  const code = [
    'new Promise(function(r) {',
    '  try {',
    '    var inj = angular.element(document.body).injector();',
    '    if (!inj) { r(JSON.stringify({logged_in: false, reason: "no_angular"})); return; }',
    '    var h = inj.get("$http");',
    '    h.get("/api/now/table/sys_user?sysparm_query=user_name=javascript:gs.getUserName()&sysparm_fields=sys_id,user_name,name,email&sysparm_limit=1").then(function(resp) {',
    '      var users = resp.data.result || [];',
    '      if (users.length > 0) {',
    '        r(JSON.stringify({logged_in: true, user: users[0]}));',
    '      } else {',
    '        r(JSON.stringify({logged_in: false, reason: "no_user"}));',
    '      }',
    '    }).catch(function(e) {',
    '      r(JSON.stringify({logged_in: false, reason: "api_error", status: e.status}));',
    '    });',
    '  } catch(e) {',
    '    r(JSON.stringify({logged_in: false, reason: "exception", msg: e.message}));',
    '  }',
    '})'
  ].join('\n');
  await fs.writeFile(tmpFile, code);
  const result = await exec('playwright-cli eval-file ' + tmpFile + ' --tab=' + tabId);
  await fs.rm(tmpFile).catch(function() {});
  if (result.exitCode !== 0) return { logged_in: false, reason: 'eval_failed' };
  try {
    return JSON.parse(result.stdout.trim());
  } catch (e) {
    return { logged_in: false, reason: 'parse_failed' };
  }
}

// Extract Coveo config from the portal page (org, token, search hub)
async function detectCoveoConfig() {
  const portalId = getPortalId();
  const data = await spGet('/api/now/sp/page?id=adb_esc_my_requests&portal_id=' + portalId);
  const containers = data.result && data.result.containers || [];
  for (const c of containers) {
    for (const row of (c.rows || [])) {
      for (const col of (row.columns || [])) {
        for (const w of (col.widgets || [])) {
          const coveo = w.widget && w.widget.data && w.widget.data.coveo;
          if (coveo && coveo.accessToken) {
            return {
              coveo_org: coveo.organizationId || null,
              coveo_search_hub: coveo.searchHub || null
            };
          }
        }
      }
    }
  }
  return null;
}

// SP GET via Angular $http
async function spGet(path) {
  const code = [
    'new Promise(function(resolve) {',
    '  var h = angular.element(document.body).injector().get("$http");',
    '  h.get("' + path.replace(/"/g, '\\"') + '").then(function(resp) {',
    '    resolve(JSON.stringify(resp.data));',
    '  }).catch(function(e) {',
    '    resolve(JSON.stringify({__error: e.status || 500, detail: e.data || "unknown"}));',
    '  });',
    '})'
  ].join('\n');

  const data = await evalInPage(code);
  if (data && data.__error) {
    if (data.__error === 401 || data.__error === 403) {
      console.error('Session expired. Log into adobe.service-now.com and try again.');
      process.exit(1);
    }
    throw new Error('SP API error ' + data.__error + ': ' + JSON.stringify(data.detail));
  }
  return data;
}

// SP POST via Angular $http
async function spPost(path, body) {
  const bodyJson = JSON.stringify(body).replace(/\\/g, '\\\\').replace(/"/g, '\\"');
  const code = [
    'new Promise(function(resolve) {',
    '  var h = angular.element(document.body).injector().get("$http");',
    '  var payload = JSON.parse("' + bodyJson + '");',
    '  h.post("' + path.replace(/"/g, '\\"') + '", payload).then(function(resp) {',
    '    resolve(JSON.stringify(resp.data));',
    '  }).catch(function(e) {',
    '    resolve(JSON.stringify({__error: e.status || 500, detail: e.data || "unknown"}));',
    '  });',
    '})'
  ].join('\n');

  const data = await evalInPage(code);
  if (data && data.__error) {
    if (data.__error === 401 || data.__error === 403) {
      console.error('Session expired. Log into adobe.service-now.com and try again.');
      process.exit(1);
    }
    throw new Error('SP API error ' + data.__error + ': ' + JSON.stringify(data.detail));
  }
  return data;
}

// Get Coveo search token from portal page
async function getCoveoToken() {
  const portalId = getPortalId();
  const data = await spGet('/api/now/sp/page?id=adb_esc_my_requests&portal_id=' + portalId);
  const containers = data.result && data.result.containers || [];
  for (const c of containers) {
    for (const row of (c.rows || [])) {
      for (const col of (row.columns || [])) {
        for (const w of (col.widgets || [])) {
          const coveo = w.widget && w.widget.data && w.widget.data.coveo;
          if (coveo && coveo.accessToken) return coveo.accessToken;
        }
      }
    }
  }
  throw new Error('Could not extract Coveo token from portal page');
}

// Table API via Angular $http (works for lookups and listing)
async function tableGet(table, query, fields, limit) {
  limit = limit || 10;
  var url = '/api/now/table/' + table + '?sysparm_query=' + encodeURIComponent(query);
  if (fields) url += '&sysparm_fields=' + encodeURIComponent(fields);
  url += '&sysparm_limit=' + limit;
  const data = await spGet(url);
  return data.result || [];
}

// Coveo KB search
async function coveoSearch(query, numResults) {
  numResults = numResults || 10;
  const token = await getCoveoToken();
  const coveoOrg = getCoveoOrg();
  const searchHub = getCoveoSearchHub();
  const url = 'https://' + coveoOrg + '.org.coveo.com/rest/search/v2?organizationId=' + coveoOrg;
  const resp = await fetch(url, {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer ' + token,
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({
      q: query,
      numberOfResults: numResults,
      searchHub: searchHub,
      fieldsToInclude: ['sn_kb_article', 'sntitle', 'snshort_description', 'sysid', 'snnumber']
    })
  });
  if (!resp.ok) {
    const text = await resp.text();
    throw new Error('Coveo search failed (' + resp.status + '): ' + text);
  }
  return resp.json();
}

// Resolve INC/RITM/REQ number to sys_id via Table API
async function resolveNumber(numberOrId) {
  if (/^[a-f0-9]{32}$/i.test(numberOrId)) {
    return { sys_id: numberOrId, table: 'incident' };
  }
  var table = 'incident';
  if (numberOrId.startsWith('RITM')) table = 'sc_req_item';
  else if (numberOrId.startsWith('REQ')) table = 'sc_request';

  const results = await tableGet(table, 'number=' + numberOrId, 'sys_id', 1);
  if (results.length > 0) {
    return { sys_id: results[0].sys_id, table: table };
  }
  console.error('Could not resolve ' + numberOrId + '. Ticket not found.');
  process.exit(1);
}

// Extract widgets from page response
function extractWidgets(pageData) {
  const widgets = [];
  const containers = pageData.result && pageData.result.containers || [];
  for (const c of containers) {
    for (const row of (c.rows || [])) {
      for (const col of (row.columns || [])) {
        for (const w of (col.widgets || [])) {
          if (w.widget) widgets.push(w.widget);
        }
      }
    }
  }
  return widgets;
}

function findWidget(widgets, name) {
  return widgets.find(function(w) { return w.name === name; });
}

function stripHtml(html) {
  if (!html) return '';
  return html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&nbsp;/g, ' ').replace(/\r\n/g, '\n').trim();
}

// --- Commands ---

async function cmdLogin(args) {
  // Parse optional --domain flag
  var domain = DEFAULTS.domain;
  for (var i = 0; i < args.length; i++) {
    if (args[i].startsWith('--domain=')) {
      domain = args[i].split('=')[1];
    }
  }

  // Save domain early so ensureTab uses it
  var config = (await loadConfig()) || {};
  config.domain = domain;
  await saveConfig(config);

  console.log('Opening ServiceNow at ' + domain + '...');
  console.log('Please complete SSO login in the browser if prompted.');

  // Open the tab
  await ensureTab();

  // Poll for login completion (check every 3 seconds, up to 2 minutes)
  var maxAttempts = 40;
  var attempt = 0;
  var loginResult = null;

  while (attempt < maxAttempts) {
    attempt++;
    await new Promise(function(resolve) { setTimeout(resolve, 3000); });
    loginResult = await checkLoggedIn();
    if (loginResult.logged_in) break;
    if (attempt % 5 === 0) {
      console.log('Waiting for login... (' + (attempt * 3) + 's)');
    }
  }

  if (!loginResult || !loginResult.logged_in) {
    console.error('Login timed out after 2 minutes. Please try again.');
    process.exit(1);
  }

  var user = loginResult.user;
  console.log('Logged in as: ' + user.name + ' (' + user.email + ')');

  // Detect Coveo config from the portal
  var coveoConfig = null;
  try {
    coveoConfig = await detectCoveoConfig();
  } catch (e) {
    // Non-fatal — Coveo might not be available
  }

  // Save full config
  config.domain = domain;
  config.user_sys_id = user.sys_id;
  config.user_name = user.user_name;
  config.user_display_name = user.name;
  config.user_email = user.email;
  if (coveoConfig) {
    if (coveoConfig.coveo_org) config.coveo_org = coveoConfig.coveo_org;
    if (coveoConfig.coveo_search_hub) config.coveo_search_hub = coveoConfig.coveo_search_hub;
  }
  config.logged_in_at = new Date().toISOString();
  await saveConfig(config);

  console.log('Configuration saved to ' + CONFIG_FILE);
  console.log('');
  console.log('You can now use:');
  console.log('  servicenow tickets       — list your open tickets');
  console.log('  servicenow kb "query"    — search the knowledge base');
}

async function cmdWhoami() {
  var config = await loadConfig();
  if (!config || !config.user_sys_id) {
    console.log('Not logged in. Run `servicenow login` to authenticate.');
    return;
  }
  console.log(JSON.stringify({
    name: config.user_display_name,
    email: config.user_email,
    username: config.user_name,
    sys_id: config.user_sys_id,
    domain: config.domain,
    logged_in_at: config.logged_in_at
  }, null, 2));
}

async function cmdTickets(args) {
  await ensureAuth();
  var userSysId = getUserSysId();

  // Parse flags
  var stateFilter = '1,2,3'; // Default: New, In Progress, On Hold
  var tableFilter = null; // null means show both incidents + requests
  for (var i = 0; i < args.length; i++) {
    if (args[i].startsWith('--state=')) {
      var stateMap = { 'new': '1', 'in-progress': '2', 'on-hold': '3', 'resolved': '6', 'closed': '7', 'all': '1,2,3,6,7' };
      var val = args[i].split('=')[1];
      stateFilter = stateMap[val] || val;
    }
    if (args[i] === '--incidents') tableFilter = 'incident';
    if (args[i] === '--requests') tableFilter = 'sc_req_item';
    if (args[i].startsWith('--table=')) tableFilter = args[i].split('=')[1];
  }

  var stateLabels = { '1': 'New', '2': 'In Progress', '3': 'On Hold', '6': 'Resolved', '7': 'Closed' };
  var allTickets = [];

  // Incidents
  if (!tableFilter || tableFilter === 'incident') {
    var incQuery = 'caller_id=' + userSysId + '^stateIN' + stateFilter + '^ORDERBYDESCsys_created_on';
    var incFields = 'number,short_description,state,priority,sys_id,sys_created_on';
    var incidents = await tableGet('incident', incQuery, incFields, 20);
    incidents.forEach(function(r) {
      allTickets.push({
        number: r.number,
        type: 'Incident',
        description: r.short_description,
        state: stateLabels[r.state] || r.state,
        priority: r.priority,
        created: r.sys_created_on,
        sys_id: r.sys_id
      });
    });
  }

  // Request Items
  if (!tableFilter || tableFilter === 'sc_req_item') {
    var ritmQuery = 'request.requested_for=' + userSysId + '^stateNOT IN3,4,7^ORDERBYDESCsys_created_on';
    var ritmFields = 'number,short_description,state,sys_id,sys_created_on';
    var ritms = await tableGet('sc_req_item', ritmQuery, ritmFields, 20);
    ritms.forEach(function(r) {
      allTickets.push({
        number: r.number,
        type: 'Request',
        description: r.short_description,
        state: r.state === '1' ? 'Open' : r.state === '2' ? 'Work in Progress' : r.state,
        priority: '',
        created: r.sys_created_on,
        sys_id: r.sys_id
      });
    });
  }

  if (allTickets.length === 0) {
    console.log('No tickets found matching the criteria.');
    return;
  }

  console.log(JSON.stringify(allTickets, null, 2));
}

async function cmdGet(numberOrId) {
  if (!numberOrId) {
    console.error('Usage: servicenow get <INC_NUMBER or sys_id>');
    process.exit(1);
  }
  await ensureAuth();
  const resolved = await resolveNumber(numberOrId);

  // Get ticket page
  const portalId = getPortalId();
  const pageData = await spGet('/api/now/sp/page?id=ticket&table=' + resolved.table + '&sys_id=' + resolved.sys_id + '&portal_id=' + portalId);
  const widgets = extractWidgets(pageData);
  const header = findWidget(widgets, 'ADB Standard Ticket Header');
  const headerData = header && header.data;

  // Get conversation
  const convData = await spPost('/api/now/sp/widget/' + TICKET_WIDGET + '?id=ticket&sys_id=' + resolved.sys_id + '&table=' + resolved.table, {
    sys_id: resolved.sys_id,
    isPosting: false
  });
  const stream = convData.result && convData.result.data && convData.result.data.stream;

  const stateField = headerData && headerData.headerFields && headerData.headerFields.find(function(f) { return f.name === 'state'; });
  const createdField = headerData && headerData.headerFields && headerData.headerFields.find(function(f) { return f.name === 'sys_created_on'; });
  const updatedField = headerData && headerData.headerFields && headerData.headerFields.find(function(f) { return f.name === 'sys_updated_on'; });

  const result = {
    number: headerData && headerData.number && headerData.number.display_value,
    title: headerData && headerData.title,
    state: stateField && stateField.display_value,
    created: createdField && createdField.display_value,
    updated: updatedField && updatedField.display_value,
    fields: headerData && headerData.fields && headerData.fields.map(function(f) {
      var obj = {};
      obj[f.label] = f.display_value;
      return obj;
    }),
    comments: stream && stream.entries && stream.entries.map(function(e) {
      return {
        author: e.name,
        date: e.sys_created_on_adjusted,
        type: e.field_label || e.element,
        text: e.element === 'attachment' ? '[Attachment: ' + (e.attachment && e.attachment.file_name || 'unknown') + ']' : stripHtml(e.value).substring(0, 500)
      };
    }) || []
  };
  console.log(JSON.stringify(result, null, 2));
}

async function cmdComment(numberOrId, message) {
  if (!numberOrId || !message) {
    console.error('Usage: servicenow comment <INC_NUMBER> <MESSAGE>');
    process.exit(1);
  }
  await ensureAuth();
  const resolved = await resolveNumber(numberOrId);
  await spPost('/api/now/sp/widget/' + TICKET_WIDGET + '?id=ticket&sys_id=' + resolved.sys_id + '&table=' + resolved.table, {
    sys_id: resolved.sys_id,
    isPosting: true,
    journalEntry: message,
    journalEntryField: 'comments',
    table: resolved.table
  });
  console.log('Comment posted on ' + numberOrId + '.');
}

async function cmdWorknote(numberOrId, message) {
  if (!numberOrId || !message) {
    console.error('Usage: servicenow worknote <INC_NUMBER> <MESSAGE>');
    process.exit(1);
  }
  await ensureAuth();
  const resolved = await resolveNumber(numberOrId);
  await spPost('/api/now/sp/widget/' + TICKET_WIDGET + '?id=ticket&sys_id=' + resolved.sys_id + '&table=' + resolved.table, {
    sys_id: resolved.sys_id,
    isPosting: true,
    journalEntry: message,
    journalEntryField: 'work_notes',
    table: resolved.table
  });
  console.log('Work note posted on ' + numberOrId + '.');
}

async function cmdKb(query) {
  if (!query) {
    console.error('Usage: servicenow kb <SEARCH_QUERY>');
    process.exit(1);
  }
  await ensureAuth();
  const search = await coveoSearch(query, 10);
  if (!search.results || search.results.length === 0) {
    console.log('No KB articles found.');
    return;
  }
  const articles = search.results.map(function(r) {
    return {
      title: r.title,
      number: (r.raw && (r.raw.sn_kb_article || r.raw.snnumber)) || '',
      excerpt: (r.excerpt || '').replace(/<[^>]+>/g, '').trim().substring(0, 200)
    };
  });
  console.log(JSON.stringify(articles, null, 2));
}

async function cmdKbArticle(kbNumber) {
  if (!kbNumber) {
    console.error('Usage: servicenow kb-article <KB_NUMBER>');
    process.exit(1);
  }
  await ensureAuth();
  const portalId = getPortalId();
  const pageData = await spGet('/api/now/sp/page?id=adb_esc_kb_article&sysparm_article=' + kbNumber + '&portal_id=' + portalId);
  const widgets = extractWidgets(pageData);
  const articleWidget = findWidget(widgets, 'ADB: KB Article Page');
  const article = articleWidget && articleWidget.data;

  if (!article || !article.number) {
    console.error('KB article ' + kbNumber + ' not found.');
    process.exit(1);
  }

  const result = {
    number: article.number,
    title: article.short_description,
    issue: stripHtml(article.issue_or_question),
    applies_to: stripHtml(article.applies_to),
    solution: stripHtml(article.solution_or_steps),
    additional_info: stripHtml(article.additional_information),
    modified: article.modified_on,
    views: article.sys_view_count
  };
  console.log(JSON.stringify(result, null, 2));
}

