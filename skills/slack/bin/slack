#!/bin/sh
# slack: the npm/pnpm bin for this skill. Runs scripts/slack.jsh under jsh on a
# host, with sliccy:browser driving Chrome over SLICC_CDP_URL (see SKILL.md).
# npm links a bin as a symlink, so follow it back to the skill folder.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
if ! command -v jsh >/dev/null 2>&1; then
  echo "slack: jsh is not on PATH. Install it: curl -fsSL https://raw.githubusercontent.com/ai-ecoverse/slicc-jsh/main/install.sh | sh" >&2
  exit 127
fi
# Chrome's default DevTools port, unless SLICC_CDP_URL names another.
SLICC_CDP_URL=${SLICC_CDP_URL:-http://127.0.0.1:9222}
export SLICC_CDP_URL
exec jsh "$(dirname "$self")/../scripts/slack.jsh" "$@"
