{
  "name": "skills-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Root tooling for the skills repo (Biome lint/format, aligned with SLICC).",
  "license": "Apache-2.0",
  "scripts": {
    "format": "biome format --write",
    "lint:jsh": "bash tools/lint-jsh.sh",
    "check": "biome check",
    "test": "node --test \"tools/**/*.test.mjs\" \"test/integration/*.test.mjs\"",
    "check:jsh-parse": "node tools/check-jsh-parse.mjs",
    "prepare": "slicc-install-hooks",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test \"test/unit/**/*.test.mjs\"",
    "lint": "npm run check:jsh-parse && npm run lint:jsh && git ls-files | bash tools/expect-verdict.sh check-tessl-layout node tools/check-tessl-layout.mjs && git ls-files -s | bash tools/expect-verdict.sh check-skill-packages node tools/check-skill-packages.mjs && biome ci test .releaserc.json renovate.json",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/biome-jsh": "6.259.9",
    "@ai-ecoverse/slicc-cdp": "1.48.2",
    "@ai-ecoverse/slicc-jsh": "0.64.4",
    "@ai-ecoverse/slicc-kernel": "1.179.0",
    "@ai-ecoverse/slicc-shared-web": "2.14.2",
    "@ai-ecoverse/wasi-pnpm": "12.9.1-21",
    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-15",
    "@biomejs/biome": "2.6.5",
    "lefthook": "2.2.2",
    "minimatch": "11.0.4",
    "monocart-coverage-reports": "3.2.0",
    "semantic-release": "25.0.9",
    "tst": "9.5.0"
  },
  "slicc": {
    "unitSources": [
      "tools"
    ]
  }
}
