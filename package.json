{
  "name": "skills-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Root tooling for the skills repo (Biome lint/format, aligned with SLICC).",
  "license": "Apache-2.0",
  "scripts": {
    "format": "biome format --write",
    "lint:jsh": "bash tools/lint-jsh.sh",
    "check": "biome check",
    "test": "node --test \"tools/*.test.mjs\"",
    "check:jsh-parse": "node tools/check-jsh-parse.mjs",
    "prepare": "slicc-install-hooks",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test \"test/unit/**/*.test.mjs\""
  },
  "devDependencies": {
    "@ai-ecoverse/biome-jsh": "6.243.1",
    "@ai-ecoverse/slicc-shared-web": "1.29.7",
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.2",
    "minimatch": "10.2.6",
    "monocart-coverage-reports": "3.0.0"
  },
  "slicc": {
    "unitSources": [
      "tools"
    ]
  }
}
