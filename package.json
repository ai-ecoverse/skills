{
  "name": "skills-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Root tooling for the skills repo (Biome lint/format, aligned with SLICC).",
  "license": "Apache-2.0",
  "scripts": {
    "format": "biome format --write",
    "lint:jsh": "bash tools/lint-jsh.sh",
    "check": "biome check",
    "test": "node --test \"tools/**/*.test.mjs\" \"test/integration/*.test.mjs\"",
    "check:jsh-parse": "node tools/check-jsh-parse.mjs",
    "prepare": "slicc-install-hooks",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test \"test/unit/**/*.test.mjs\"",
    "lint": "npm run check:jsh-parse && npm run lint:jsh && git ls-files | bash tools/expect-verdict.sh check-tessl-layout node tools/check-tessl-layout.mjs && biome ci test .releaserc.json renovate.json",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/biome-jsh": "6.243.1",
    "@ai-ecoverse/slicc-cdp": "1.39.1",
    "@ai-ecoverse/slicc-shared-web": "2.11.2",
    "@biomejs/biome": "2.6.2",
    "lefthook": "2.2.2",
    "minimatch": "10.2.6",
    "monocart-coverage-reports": "3.0.0",
    "semantic-release": "25.0.9"
  },
  "slicc": {
    "unitSources": [
      "tools"
    ]
  }
}
