{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "groupName": "remotion monorepo",
      "matchPackageNames": ["remotion", "@remotion/**"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom"]
    },
    {
      "matchPackageNames": ["@ai-ecoverse/slicc-shared-web"],
      "allowedVersions": "<2"
    }
  ]
}
